    "钟与太阳相差不到1分钟": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钟与太阳相差不到1分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時鐘與太陽相差不到1分鐘"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock matches the sun to within a minute"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計と太陽の差は1分未満です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계와 태양의 차이가 1분 미만입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr und Sonne liegen weniger als eine Minute auseinander"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj y el sol difieren menos de un minuto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge et le soleil diffèrent de moins d’une minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы и солнце расходятся меньше чем на минуту"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio e o sol diferem em menos de 1 minuto"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar i czas słoneczny różnią się o mniej niż minutę"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klok en zon verschillen minder dan 1 minuut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orologio e Sole differiscono di meno di un minuto"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ và mặt trời lệch nhau chưa đến 1 phút"
          }
        },
        "tr": {
          "stringUnit": {
