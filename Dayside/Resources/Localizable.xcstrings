    "没有对应的地点时，顺序不变": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有对应的地点时，顺序不变"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no place matches, the order stays the same"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有對應的地點時，順序不變"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する場所がないときは順序は変わりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 장소가 없으면 순서는 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne passenden Ort bleibt die Reihenfolge unverändert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ningún lugar coincide, el orden no cambia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun lieu ne correspond, l’ordre reste inchangé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nenhum local corresponder, a ordem não muda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если подходящего места нет, порядок не меняется"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nessun luogo corrisponde, l’ordine resta invariato"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder overeenkomende locatie blijft de volgorde gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy żadne miejsce nie pasuje, kolejność się nie zmienia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen konum yoksa sıralama değişmez"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có địa điểm tương ứng, thứ tự không đổi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak ada lokasi yang cocok, urutan tetap sama"
          }
        }
      }
    },
