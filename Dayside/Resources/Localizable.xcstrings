          "stringUnit": {
            "state": "translated",
            "value": "Se la fine precede l’inizio, la fascia passa al giorno successivo; se gli orari coincidono, copre l’intera giornata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de eindtijd vóór de begintijd ligt, loopt het tijdvak door tot de volgende dag. Gelijke tijden betekenen de hele dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koniec przed początkiem oznacza przejście na następny dzień; równe godziny oznaczają cały dzień"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitiş saati başlangıç saatinden önceyse aralık ertesi güne uzanır; saatler aynıysa tam gün demektir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ kết thúc sớm hơn giờ bắt đầu nghĩa là qua đêm; giờ bắt đầu và kết thúc trùng nhau nghĩa là cả ngày"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika waktu selesai lebih awal daripada waktu mulai, rentangnya melewati tengah malam; waktu mulai dan selesai yang sama berarti seharian"
          }
        }
      }
    },
