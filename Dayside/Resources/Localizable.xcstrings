    "粘贴对方用 Dayside 分享的链接或片段。地点和作息会变成一位人物，两台 Mac 各自算重叠，不经过任何服务器。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴对方分享的时间名片（链接或文字）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上對方分享的時間名片（連結或文字）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a Time Card someone shared (a link or text)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が共有した時間の名刺（リンクまたはテキスト）をペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대가 공유한 시간 카드(링크 또는 텍스트)를 붙여 넣으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine geteilte Zeitkarte ein (Link oder Text)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una tarjeta horaria que alguien haya compartido contigo (un enlace o texto)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une carte horaire partagée par quelqu’un (un lien ou du texte)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылку или текст карточки времени, которой кто-то поделился."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um cartão de horário que alguém compartilhou (um link ou texto)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej wizytówkę czasu od kogoś (łącze lub tekst)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een tijdkaart die iemand heeft gedeeld (een link of tekst)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una scheda oraria condivisa da qualcuno (link o testo)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán danh thiếp thời gian mà người khác chia sẻ (liên kết hoặc văn bản)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşı tarafın paylaştığı Zaman Kartını yapıştırın (bağlantı veya metin)."
