    "提醒未能安排，请稍后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安排提醒，请稍后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t schedule the alert. Try again later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安排提醒，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を予約できませんでした。しばらくしてからやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 예약할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerung konnte nicht geplant werden. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido programar el aviso. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de programmer le rappel. Réessayez plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запланировать напоминание. Повторите позже."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível agendar o alerta. Tente novamente mais tarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaplanować przypomnienia. Spróbuj ponownie później."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De waarschuwing kon niet worden gepland. Probeer het later opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile programmare l’avviso. Riprova più tardi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lên lịch nhắc. Hãy thử lại sau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı planlanamadı. Daha sonra yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjadwalkan pengingat. Coba lagi nanti."
          }
        }
      }
    },
    "提醒设置无法读取，已备份原始数据并保持关闭。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒设置无法读取，已备份原始数据，提醒保持关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert settings couldn’t be read. The original data was backed up and alerts are off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取提醒設定，已備份原始資料，提醒保持關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知設定を読み取れませんでした。元のデータをバックアップし、通知はオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 설정을 읽을 수 없어 원본 데이터를 백업하고 알림을 꺼 둔 상태로 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerungseinstellungen konnten nicht gelesen werden. Das Original wurde gesichert, Erinnerungen bleiben aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer los ajustes de los avisos. Se ha guardado una copia de seguridad de los datos originales y los avisos permanecen desactivados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les réglages des rappels. L’original a été sauvegardé et les rappels restent désactivés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать настройки напоминаний. Создана резервная копия исходных данных; напоминания остаются выключенными."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os ajustes dos alertas. Os dados originais foram salvos em backup e os alertas permanecem desativados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać ustawień przypomnień. Oryginalne dane zachowano w kopii zapasowej; przypomnienia pozostają wyłączone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen voor waarschuwingen konden niet worden gelezen. Er is een reservekopie van de oorspronkelijke gegevens gemaakt. Waarschuwingen blijven uitgeschakeld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le impostazioni degli avvisi. I dati originali sono stati salvati in una copia di backup e gli avvisi restano disattivati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc cài đặt nhắc; dữ liệu gốc đã được sao lưu và tính năng nhắc vẫn tắt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı ayarları okunamadı; özgün veriler yedeklendi, uyarılar kapalı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pengingat tidak dapat dibaca; data asli telah dicadangkan dan pengingat tetap nonaktif."
          }
        }
      }
    },
