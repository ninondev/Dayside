    "“我这边”按 %@ 算（原文写了在那里）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我这边”按%@算（原文写了在那里）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“My time” is taken as %@ (the text says the writer is there)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「我這邊」按%@計算（原文已註明寫信人在哪裡）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“こちらの時間”は%@として計算します（原文に差出人がそこにいると書かれています）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“내 시간”은 %@ 기준으로 계산합니다(원문에 위치가 명시되어 있음)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Meine Zeit“ gilt als %@ (im Text steht, wo der Absender ist)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mi hora” se calcula según %@ (el texto indica dónde está quien escribe)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour « Mon heure », le calcul utilise %@ (le texte indique que l’expéditeur s’y trouve)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Моё время» определяется так: %@ (в тексте указано, что автор находится там)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Meu horário” usa %@ (o texto informa que o remetente está lá)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„U mnie” odczytano jako %@ (tekst podaje, że nadawca tam jest)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Mijn tijd' wordt opgevat als %@ (in de tekst staat dat de afzender daar is)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“La mia ora” è calcolata come %@ (il testo indica dove si trova chi scrive)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Giờ bên tôi” được tính theo %@ (văn bản ghi người viết ở đó)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Benim saatimle” için %@ kullanılıyor (metinde gönderenin orada olduğu yazıyor)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Waktu saya” dihitung sebagai %@ (teks menyatakan penulisnya berada di sana)"
          }
        }
      }
    },
    "“我这边”按 %1$@ 算：由同一行的 %2$@ 推出": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我这边”按%1$@算：由同一行的%2$@推出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“My time” is taken as %1$@: inferred from %2$@ on the same line"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「我這邊」按%1$@計算：由同一行的%2$@推得"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“こちらの時間”は%1$@として計算します。同じ行の%2$@から推定しています"
