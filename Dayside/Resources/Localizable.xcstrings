    "往前挪每晚最多 1小时；往后挪可到 2小时。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往前挪每晚最多1小时；往后挪可到2小时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier: at most 1 hour a night. Later: up to 2 hours."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提早作息每晚最多1小時；延後作息可到2小時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早める場合は1晩に最大1時間、遅らせる場合は最大2時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞당길 때는 하룻밤에 최대 1시간, 늦출 때는 최대 2시간입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раньше: не более 1 часа за ночь. Позже: до 2 часов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früher: höchstens 1 Stunde pro Nacht. Später: bis zu 2 Stunden pro Nacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tôt : au plus 1 heure par nuit. Plus tard : jusqu’à 2 heures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más temprano: como máximo 1 hora por noche. Más tarde: hasta 2 horas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais cedo: no máximo 1 hora por noite. Mais tarde: até 2 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anticipo: massimo 1 ora a notte. Posticipo: fino a 2 ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerder: maximaal 1 uur per nacht. Later: maximaal 2 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniej: najwyżej 1 godzina na noc. Później: do 2 godzin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkene kaydırma: gecede en fazla 1 saat. Daha geçe kaydırma: gecede en fazla 2 saat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sớm hơn: tối đa 1 giờ mỗi đêm. Muộn hơn: tối đa 2 giờ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih awal: maksimal 1 jam per malam. Lebih larut: hingga 2 jam."
          }
        }
      }
    },
