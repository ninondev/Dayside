    "有让所有人都在工作时段内的时刻，不用拆场。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt gemeinsame Arbeitszeit; eine Aufteilung ist nicht nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are shared work hours, so there’s no need to split."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay horario laboral común; no hace falta dividir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe des créneaux de travail communs ; il n’est pas nécessaire de répartir les participants en plusieurs séances."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共通の勤務時間があるので、分ける必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공통 근무 시간이 있어 나눌 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há horário de trabalho em comum, então não é preciso dividir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть общее рабочее время, разделение не требуется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有共同工作时段，不用拆场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有共同工作時段，不用拆場。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są wspólne godziny pracy, więc nie trzeba dzielić na tury."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is gezamenlijke werktijd. Splitsen is niet nodig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono fasce di lavoro comuni, non serve suddividere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có giờ làm việc chung, không cần chia phiên."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak çalışma saati var, bölmeye gerek yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada jam kerja bersama, jadi tidak perlu dibagi."
          }
        }
      }
    },
