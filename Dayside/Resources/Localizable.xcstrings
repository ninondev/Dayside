    "把 ${expression} 从 ${sourceTimeZone} 换算到已保存的地点": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 ${expression}从 ${sourceTimeZone}换算到已保存的地点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將${expression}從${sourceTimeZone}換算到已儲存的地點"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert ${expression} from ${sourceTimeZone} to your saved places"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${expression}を${sourceTimeZone}から保存した場所の時刻に変換"
          }
