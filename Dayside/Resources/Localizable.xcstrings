    "暂时无法计算这个日期或地点。请选择 1800 至 2100 年之间的日期。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法计算这个日期或地点。请选1800到2100年之间的日期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t calculate this date or place. Choose a date between 1800 and 2100."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法計算這個日期或地點。請選擇1800至2100年之間的日期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付または場所を計算できませんでした。1800〜2100年の日付を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜 또는 장소를 계산할 수 없습니다. 1800~2100년 사이의 날짜를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Datum oder diesen Ort ist keine Berechnung möglich. Wähle ein Datum zwischen 1800 und 2100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido hacer el cálculo para esta fecha o lugar. Elige una fecha entre 1800 y 2100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcul indisponible pour cette date ou ce lieu. Choisissez une date entre 1800 et 2100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось рассчитать для этой даты или места. Выберите дату с 1800 по 2100 год."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível calcular para essa data ou local. Escolha uma data entre 1800 e 2100."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wykonać obliczeń dla tej daty lub tego miejsca. Wybierz datę z lat 1800–2100."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon deze datum of locatie niet berekenen. Kies een datum van 1800 tot en met 2100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile calcolare per questa data o questo luogo. Scegli una data tra il 1800 e il 2100."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tính cho ngày hoặc địa điểm này. Hãy chọn ngày trong khoảng từ năm 1800 đến năm 2100."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarih veya konum için hesaplama yapılamıyor. 1800 ile 2100 yılları arasında bir tarih seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal atau lokasi ini tidak dapat dihitung. Pilih tanggal antara tahun 1800 dan 2100."
          }
        }
      }
    },
