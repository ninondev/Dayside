    "显示名最多 80 个字符，且不能包含换行或控制字符。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姓名最多80个字符，不能有换行或控制字符。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can be up to 80 characters, with no line breaks or control characters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "姓名最多80個字元，不能有換行或控制字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は80文字以内で、改行や制御文字は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 최대 80자이며 줄 바꿈이나 제어 문자를 포함할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name darf höchstens 80 Zeichen und keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre puede tener como máximo 80 caracteres, sin saltos de línea ni caracteres de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom est limité à 80 caractères, sans saut de ligne ni caractère de contrôle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя может содержать до 80 символов, без переносов строк и управляющих символов."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome pode ter até 80 caracteres, sem quebras de linha nem caracteres de controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imię i nazwisko mogą mieć łącznie najwyżej 80 znaków, bez podziałów wierszy i znaków sterujących."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam mag maximaal 80 tekens bevatten, zonder regeleinden of stuurtekens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome può contenere fino a 80 caratteri, senza a capo o caratteri di controllo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên tối đa 80 ký tự, không được có xuống dòng hoặc ký tự điều khiển."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad en fazla 80 karakter olabilir; satır sonu veya denetim karakteri içeremez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama maksimal 80 karakter, tanpa baris baru atau karakter kontrol."
          }
        }
      },
      "extractionState": "manual"
    },
