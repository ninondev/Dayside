    "暂停会关闭提醒，但不会改变闹钟的目标时刻。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停只关提醒，闹钟时刻不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing turns off the alert; the alarm time stays the same."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停只會關閉提醒，鬧鐘時間不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止すると通知はオフになりますが、アラームの時刻は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지하면 알림이 꺼지지만 알람 시각은 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren schaltet die Mitteilung aus, ändert aber nicht die Zielzeit des Weckers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar solo desactiva el aviso; la hora de la alarma no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pause désactive le rappel ; l’heure de l’alarme ne change pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза отключает уведомление, но время будильника не меняется."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar desativa os alertas, mas o horário do alarme não muda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymanie wyłącza tylko przypomnienie; godzina budzika pozostaje bez zmian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeren zet meldingen uit, maar de wektijd blijft staan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pausa disattiva gli avvisi; l’ora della sveglia non cambia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng sẽ tắt lời nhắc nhưng giờ báo thức không đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatmak bildirimi kapatır; alarmın hedef saati değişmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda mematikan peringatan; waktu alarm tetap."
          }
        }
      }
    },
