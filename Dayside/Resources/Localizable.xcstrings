    "预约邮箱要写成 name@example.com 这样的形式，不能有空格或引号。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约邮箱要写成name@example.com这样的形式，不能有空格或引号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預約用的電子郵件地址須採用name@example.com這樣的格式，不能含有空格或引號。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The booking email must look like name@example.com, without spaces or quotes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約用メールアドレスはname@example.comの形式で、スペースや引用符は使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 이메일은 name@example.com 형식이어야 하며 공백이나 따옴표를 쓸 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse muss wie name@example.com aussehen, ohne Leerzeichen oder Anführungszeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo electrónico para las reservas debe tener la forma nombre@ejemplo.com, sin espacios ni comillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse e-mail de réservation doit être au format name@example.com, sans espaces ni guillemets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O e-mail deve ter o formato name@example.com, sem espaços nem aspas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес электронной почты для запросов должен иметь вид name@example.com, без пробелов и кавычек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres e-mail do rezerwacji musi mieć postać imie@example.com, bez spacji i cudzysłowów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het e-mailadres moet eruitzien als name@example.com, zonder spaties of aanhalingstekens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’e-mail per le prenotazioni deve avere la forma nome@example.com, senza spazi né virgolette."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email đặt hẹn phải có dạng name@example.com, không có dấu cách hay dấu ngoặc kép."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Randevu e-postası kullanici@example.com biçiminde olmalı; boşluk veya tırnak içeremez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email untuk janji temu harus berformat seperti name@example.com, tanpa spasi atau tanda kutip."
          }
        }
      }
    },
