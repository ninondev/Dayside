    "本机时区数据 %@ 可能过期：%lld 条已知规则变更未反映。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机时区数据%@可能过期：有%lld条已知规则变更没反映。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機時區資料%@可能過期：有%lld條已知規則變更未反映。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This Mac’s time zone data %1$@ may be out of date: %2$lld known rule change isn’t reflected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This Mac’s time zone data %1$@ may be out of date: %2$lld known rule changes aren’t reflected."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの時間帯データ（%1$@）が古い可能性があります。既知のルール変更%2$lld件が反映されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 시간대 데이터(%1$@)가 오래되었을 수 있습니다. 알려진 규칙 변경 %2$lld건이 반영되지 않았습니다."
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Zeitzonendaten %1$@ dieses Mac sind womöglich veraltet: %2$lld bekannte Regeländerung fehlt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Zeitzonendaten %1$@ dieses Mac sind womöglich veraltet: %2$lld bekannte Regeländerungen fehlen."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los datos de zonas horarias %1$@ de este Mac podrían estar desactualizados: falta %2$lld cambio de reglas conocido."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los datos de zonas horarias %1$@ de este Mac podrían estar desactualizados: faltan %2$lld cambios de reglas conocidos."
