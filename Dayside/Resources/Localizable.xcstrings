    "行程期间有时区偏移变化，已按到达时刻计算。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程中有换钟，时差按落地时刻算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s a clock change during the trip; the time difference is based on the landing time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程中有時鐘調整，時差按降落時刻計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程中に時刻変更があります。時差は到着時点で計算しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 중 시계 조정이 있어 시차는 도착 시각 기준으로 계산합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Reise werden Uhren umgestellt; der Zeitunterschied wird für den Ankunftszeitpunkt berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un cambio de hora durante el viaje; la diferencia horaria se calcula para el momento de llegada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement d’heure a lieu pendant le trajet ; le décalage horaire est calculé au moment de l’arrivée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время поездки переводят часы; разница во времени рассчитана на момент прилёта."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma mudança de horário durante a viagem. A diferença de horário é calculada no momento da chegada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas podróży następuje zmiana czasu; różnicę czasu obliczono dla chwili przylotu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens de reis wordt de klok verzet. Het tijdsverschil wordt berekend op basis van de landingstijd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il viaggio c’è un cambio dell’ora. La differenza oraria si calcola al momento dell’arrivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lần đổi giờ trong hành trình; chênh lệch giờ được tính theo thời điểm hạ cánh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyahat sırasında saat değişikliği var; saat farkı varış anına göre hesaplanır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada perubahan jam selama perjalanan; selisih waktu dihitung berdasarkan waktu pendaratan."
          }
        }
      }
    },
