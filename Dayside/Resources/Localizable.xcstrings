    "打开后，在任何 App 里按这个组合都会打开 Dayside 面板，再按一次关上。菜单栏项被隐藏时按了不会有反应。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tastaturkürzel funktioniert nicht, wenn Dayside in der Menüleiste ausgeblendet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut doesn’t work while Dayside is hidden from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo no funciona cuando Dayside está oculto en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci n’a aucun effet lorsque Dayside est masqué dans la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのDaysideが非表示のときは、ショートカットは動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayside가 메뉴 막대에서 숨겨져 있으면 단축키가 작동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho não funciona enquanto o Dayside está oculto na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Dayside скрыт в строке меню, сочетание клавиш не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏里的Dayside被隐藏时，快捷键不起作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列裡的Dayside被隱藏時，快捷鍵不起作用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrót nie działa, gdy aplikacja Dayside jest ukryta na pasku menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toetscombinatie werkt niet zolang Dayside verborgen is in de menubalk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbreviazione non funziona quando Dayside è nascosto dalla barra dei menu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Dayside bị ẩn khỏi thanh menu, phím tắt không có tác dụng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğundaki Dayside gizliyken kestirme çalışmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Dayside disembunyikan dari bar menu, pintasan ini tidak berfungsi."
          }
        }
      }
    },
