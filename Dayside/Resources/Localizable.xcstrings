    "对方选好时段就能一键给你发预约邮件；邮箱会写进链接。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱会写进名片，对方可以直接给你发预约邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件地址會寫進名片，對方可以直接寄預約郵件給你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email is included in the card so they can send you a meeting request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスは名刺に含まれるため、相手はそのまま予約依頼メールを送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소가 카드에 포함되어 상대가 예약 메일을 보낼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse steht in der Zeitkarte, damit die andere Person dir direkt eine Terminanfrage senden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de correo se incluye en la tarjeta para que puedan enviarte una solicitud de reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre e-mail figure dans la carte ; l’autre personne peut vous envoyer directement une demande de rendez-vous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O e-mail é incluído no cartão para que a outra pessoa possa enviar a você um pedido de reunião diretamente por e-mail."
          }
        },
        "ru": {
