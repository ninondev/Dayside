    "添加一次旅行，这里会一晚一行画出几点睡、几点晒光。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一次旅行，看每晚几点睡、几点晒光。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a trip to see when to sleep and get light each night."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一次旅行，看每晚幾點睡、幾點接觸光線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行を追加すると、毎晩の睡眠と光を浴びる時間を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행을 추가하면 매일 밤 언제 자고 언제 빛을 쬘지 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте поездку, чтобы видеть время сна и пребывания на свету на каждую ночь."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Reise hinzu, um für jede Nacht Schlaf- und Lichtzeiten zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un voyage pour voir nuit par nuit quand dormir et quand vous exposer à la lumière."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un viaje para ver, noche a noche, cuándo dormir y cuándo recibir luz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma viagem para ver, noite a noite, quando dormir e buscar luz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un viaggio per vedere quando dormire e quando esporti alla luce, notte per notte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een reis toe om per nacht te zien wanneer je slaapt en wanneer je licht opzoekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj podróż, aby zobaczyć, kiedy spać i korzystać ze światła każdej nocy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gece ne zaman uyuyacağınızı ve ışık alacağınızı görmek için bir seyahat ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm chuyến đi để xem mỗi đêm ngủ và tiếp xúc với ánh sáng lúc nào."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan perjalanan untuk melihat tiap malam kapan tidur dan kapan mendapatkan cahaya."
          }
        }
      }
    },
