            "state": "translated",
            "value": "時區資料與已知規則變更一致"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯データは既知のルール変更と一致しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대 데이터가 알려진 규칙 변경과 일치합니다."
