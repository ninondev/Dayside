    "每次都有所有人在工作时段内的时刻，不需要轮换。下面是每次最合适的时刻。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都有共同工作时段，不用轮换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every meeting has shared work hours, so no rotation is needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都有共同工作時段，不需要輪換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回、共通の勤務時間があるため、持ち回りは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 회차에 공통 근무 시간이 있어 순환이 필요 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jede Besprechung gibt es gemeinsame Arbeitszeit; eine Rotation ist nicht nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las reuniones tienen horario laboral común; no hace falta rotar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réunion dispose d’un créneau de travail commun ; aucune rotation n’est nécessaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as reuniões têm horário de trabalho em comum, então não é preciso revezar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой встречи есть общее рабочее время, чередование не требуется."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde spotkanie ma wspólne godziny pracy, więc rotacja nie jest potrzebna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vergadering heeft gezamenlijke werktijd. Roulatie is niet nodig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riunione ha fasce di lavoro comuni, la rotazione non serve."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc họp nào cũng có giờ làm việc chung, không cần luân phiên."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her toplantı için ortak çalışma saati var, rotasyona gerek yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap rapat memiliki jam kerja bersama, jadi rotasi tidak diperlukan."
          }
        }
      }
    },
    "没有人在工作时段内。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand ist dann innerhalb der Arbeitszeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is within work hours then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie está en horario laboral en ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce créneau tombe en dehors des horaires de travail de tout le monde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時刻は全員の勤務時間外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시각은 모든 참가자의 근무 시간 밖입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está dentro do horário de trabalho."
