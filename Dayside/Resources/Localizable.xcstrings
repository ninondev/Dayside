    "无法生成分享预览。请检查所选时区和日期后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成分享预览。请检查所选地点和日期后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the preview. Check the selected place and date, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法產生分享預覽。請檢查所選地點和日期後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有プレビューを作成できませんでした。選択した場所と日付を確認してやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 미리보기를 만들 수 없습니다. 선택한 장소와 날짜를 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau konnte nicht erstellt werden. Prüfe den ausgewählten Ort und das Datum und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido generar la vista previa. Comprueba el lugar y la fecha seleccionados e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer l’aperçu du partage. Vérifiez le lieu et la date sélectionnés, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать предварительный просмотр. Проверьте выбранные места и даты и повторите попытку."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar a prévia. Confira o local e a data escolhidos e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć podglądu. Sprawdź wybrane miejsce i datę, a potem spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen voorvertoning maken. Controleer de gekozen locatie en datum en probeer het opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare l’anteprima. Controlla il luogo e la data selezionati, poi riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo bản xem trước. Hãy kiểm tra địa điểm và ngày đã chọn rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım önizlemesi oluşturulamadı. Konumu ve tarihi denetleyip yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuat pratinjau. Periksa lokasi dan tanggal yang dipilih, lalu coba lagi."
          }
        }
      }
