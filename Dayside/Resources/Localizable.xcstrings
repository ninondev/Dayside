    "%1$@ 与 %2$@ 差 %3$@：可能有一处没按夏令时改": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@与%2$@差%3$@：可能有一处没按夏令时改"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$@ differ by %3$@: one may not be adjusted for daylight saving time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@與%2$@差%3$@：可能有一處沒按日光節約時間調整"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@は%3$@ずれています。どちらかが夏時間に合わせていない可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ 간 시차는 %3$@입니다. 한쪽이 서머타임을 반영하지 않았을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ liegen %3$@ auseinander: Möglicherweise wurde die Sommerzeit an einem der Orte nicht berücksichtigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y %2$@ difieren en %3$@: puede que en uno de los lugares no se haya aplicado el horario de verano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ diffèrent de %3$@ : l’un des deux ne tient peut-être pas compte de l’heure d’été."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и %2$@ различаются на %3$@: возможно, один из вариантов не учитывает летнее время"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ diferem em %3$@: talvez um deles não considere o horário de verão"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i %2$@ różnią się o %3$@: być może w jednym z nich nie uwzględniono czasu letniego"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@ verschillen %3$@: misschien is bij een van beide de zomertijd niet meegenomen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ differiscono di %3$@: uno dei due orari potrebbe non tenere conto dell’ora legale"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ và %2$@ lệch nhau %3$@: có thể một bên chưa tính giờ mùa hè"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ile %2$@ arasında %3$@ fark var: birinde yaz saati hesaba katılmamış olabilir"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dan %2$@ berselisih %3$@: mungkin salah satunya belum disesuaikan dengan waktu musim panas"
          }
        }
      }
    },
