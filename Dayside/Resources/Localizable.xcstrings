    "菜单栏里的时钟：点一下，就是这张图和各地几点。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the clock in the menu bar to see this map and the time everywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点菜单栏里的时钟，就能看到这张图和各地几点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列裡的時鐘，就能看到這張地圖和各地時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの時計をクリックすると、この地図と各地の時刻が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 시계를 클릭하면 이 지도와 각지의 시간을 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на часы в строке меню, чтобы увидеть карту и время повсюду."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Uhr in der Menüleiste, um diese Karte und die Ortszeiten zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el reloj de la barra de menús para ver este mapa y la hora en cada lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’horloge dans la barre des menus pour voir cette carte et l’heure partout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no relógio na barra de menus para ver este mapa e a hora em cada local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’orologio nella barra dei menu per vedere questa mappa e l’ora ovunque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de klok in de menubalk om deze kaart en de tijd overal te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij zegar na pasku menu, aby zobaczyć tę mapę i godziny we wszystkich miejscach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğundaki saate tıklayarak bu haritayı ve her yerin saatini görün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bấm đồng hồ trên thanh menu để xem bản đồ này và giờ ở mọi nơi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik jam di bar menu untuk melihat peta ini dan waktu di setiap tempat."
          }
        }
      }
    },
