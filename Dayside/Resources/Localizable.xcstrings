    "已设闹钟：%1$@ 上班时（本机 %2$@）。在「计时器」页查看或取消。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker für den Arbeitsbeginn von %1$@ gestellt (%2$@ auf diesem Mac). Sieh ihn unter „Timer“ an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm set for when %1$@ starts work (%2$@ on this Mac). See it in Timers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarma programada para cuando %1$@ empiece a trabajar (%2$@ en este Mac). Consúltala en Temporizadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme réglée pour %1$@ au début de ses horaires de travail (%2$@ sur ce Mac). Consultez-la dans « Minuteurs »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを設定しました: %1$@さんの始業時（このMacでは%2$@）。“タイマー”で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 설정됨: %1$@ 출근 시(이 Mac 기준 %2$@). ‘타이머’에서 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme definido para quando %1$@ começar a trabalhar (%2$@ neste Mac). Veja em Timers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник установлен на начало рабочего дня: %1$@ (%2$@ на этом Mac). Его можно посмотреть в разделе «Таймеры»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设闹钟：%1$@上班时（本机%2$@），可在“计时器”里查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已設定鬧鐘：%1$@上班時（本機%2$@），可在「計時器」裡查看。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawiono budzik na początek pracy osoby %1$@ (%2$@ na tym Macu). Sprawdź go na stronie Minutniki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wekker ingesteld voor het begin van de werkdag van %1$@ (%2$@ op deze Mac). Bekijk de wekker in 'Timers'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglia impostata: %1$@ inizia a lavorare (%2$@ su questo Mac). Puoi vederla nella pagina Timer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đặt báo thức khi %1$@ bắt đầu làm việc (%2$@ theo giờ máy Mac này). Xem trong Hẹn giờ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm kuruldu: %1$@ çalışmaya başladığında (bu Mac’in saatiyle %2$@). Sayaçlar bölümünde görebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm diatur: saat %1$@ mulai kerja (%2$@ di Mac ini). Lihat di Timer."
          }
        }
      }
    },
