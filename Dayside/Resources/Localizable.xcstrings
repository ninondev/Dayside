    "拖动或左右轻扫改变时间 · 连按两次放大": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或左右轻扫改变时间 · 连按两次放大"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag or swipe sideways to change the time · Double-click to enlarge"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移或左右輕掃更改時間 · 按兩下放大"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグまたは左右にスワイプして時刻を変更 · ダブルクリックで拡大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하거나 좌우로 쓸어넘겨 시간 변경 · 이중 클릭하여 확대"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen oder seitlich streichen, um die Zeit zu ändern · Zum Vergrößern doppelklicken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra o desliza hacia los lados para cambiar la hora · Haz doble clic para ampliar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser ou balayer latéralement pour changer l’heure · Double-cliquer pour agrandir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите или смахните влево или вправо, чтобы изменить время · Дважды щёлкните, чтобы увеличить"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ou deslize para os lados para mudar o horário · Clique duas vezes para ampliar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij lub przesuń w bok, aby zmienić godzinę · Kliknij dwukrotnie, aby powiększyć"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep of veeg opzij om de tijd te wijzigen · Dubbelklik om te vergroten"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina o scorri lateralmente per cambiare l’ora · Doppio clic per ingrandire"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo hoặc vuốt ngang để đổi thời gian · Bấm đúp để phóng to"
          }
        },
        "tr": {
          "stringUnit": {
