          "stringUnit": {
            "state": "translated",
            "value": "지도를 오른쪽 클릭하면 이 순간을 이미지로 복사하여 다른 사람에게 보낼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните карту правой кнопкой мыши, чтобы скопировать изображение этого момента и отправить его другим."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf die Karte, um diesen Moment als Bild zu kopieren und zu versenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic secundario en el mapa para copiar este momento como imagen y enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur la carte pour copier cet instant sous forme d’image à envoyer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito no mapa para copiar este momento como uma imagem e enviar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto destro sulla mappa per copiare questo istante come immagine da inviare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op de kaart om dit moment als afbeelding te kopiëren en te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij mapę prawym przyciskiem myszy, aby skopiować tę chwilę jako obraz do wysłania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anı başkalarına gönderebileceğiniz bir görüntü olarak kopyalamak için haritaya sağ tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột phải vào bản đồ để sao chép khoảnh khắc này thành hình ảnh gửi cho người khác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan peta untuk menyalin momen ini sebagai gambar yang dapat dikirim."
          }
        }
      }
    },
    "右键点面板里的地点，直达太阳与月亮、换算和找碰头时间。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a place in the panel to jump to Sun and Moon, Time Conversion, or Find a Meeting Time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点面板里的地点，直达太阳与月亮、换算和找碰头时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以滑鼠右鍵按一下面板中的地點，直接前往「太陽與月亮」、「時間換算」或「找碰面時間」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの地点を右クリックすると、“太陽と月”、“時刻変換”、“会議の時間を探す”に移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에서 장소를 오른쪽 클릭하면 ‘태양과 달’, ‘시간 변환’, ‘회의 시간 찾기’로 바로 이동할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните место на панели правой кнопкой мыши, чтобы открыть страницу «Солнце и Луна», «Пересчёт времени» или «Найти время для встречи»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf einen Ort im Panel, um „Sonne und Mond“, „Zeitumrechnung“ oder „Besprechungszeit finden“ zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic secundario en un lugar del panel para ir a “Sol y luna”, “Conversión horaria” o “Buscar hora de reunión”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un lieu du panneau pour accéder à « Soleil et lune », « Conversion horaire » ou « Trouver un créneau »."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um local no painel para ir a “Sol e Lua”, “Conversão de Horário” ou “Encontrar Horário para Reunião”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto destro su un luogo nel pannello per aprire “Sole e Luna”, “Conversione orari” o “Trova un orario”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een locatie in het paneel om 'Zon en maan', 'Tijdconversie' of 'Zoek een vergadermoment' te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij miejsce w panelu prawym przyciskiem myszy, aby przejść do strony Słońce i Księżyc, Przeliczanie czasu lub Wspólny termin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş ve Ay, Saat Dönüştürme veya Toplantı Planlayıcısı’na gitmek için panelde bir konuma sağ tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột phải vào địa điểm trong bảng để mở Mặt trời và mặt trăng, Quy đổi giờ hoặc Tìm giờ họp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan lokasi di panel untuk membuka Matahari dan Bulan, Konversi Waktu, atau Cari Waktu Rapat."
          }
        }
      }
    },
