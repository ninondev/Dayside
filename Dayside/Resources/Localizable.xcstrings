    "标签最多 120 个字，不能包含换行。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签最多120个字，不能包含换行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels can contain up to 120 characters, with no line breaks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤最多120個字元，不能包含換行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルは120文字以内で、改行は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이블은 최대 120자이며 줄 바꿈을 포함할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bezeichnung darf höchstens 120 Zeichen und keine Zeilenumbrüche enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta puede tener hasta 120 caracteres, sin saltos de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le libellé est limité à 120 caractères, sans saut de ligne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка может содержать не более 120 символов, без переносов строк."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rótulo pode ter até 120 caracteres, sem quebras de linha."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etykieta może mieć najwyżej 120 znaków i nie może zawierać podziałów wierszy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een label mag maximaal 120 tekens bevatten, zonder regeleinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’etichetta può contenere fino a 120 caratteri, senza a capo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn tối đa 120 ký tự, không có dấu xuống dòng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket en fazla 120 karakter olabilir ve satır sonu içeremez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label maksimal 120 karakter, tanpa baris baru."
          }
        }
      }
