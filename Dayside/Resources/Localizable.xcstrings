    "在 Dayside 中开始倒计时。正在运行的计时器会保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在Dayside中开始倒计时。正在运行的计时器会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a countdown in Dayside. A running timer is kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在Dayside中開始倒數計時。正在執行的計時器會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Daysideでカウントダウンを開始します。実行中のタイマーはそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayside에서 카운트다운을 시작합니다. 실행 중인 타이머는 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen Countdown in Dayside. Ein laufender Timer bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una cuenta atrás en Dayside. Se conserva cualquier temporizador en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un compte à rebours dans Dayside. Tout minuteur en cours est conservé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает обратный отсчёт в Dayside. Текущий таймер сохраняется."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia uma contagem regressiva no Dayside. O timer em andamento é mantido."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna odliczanie w aplikacji Dayside. Działający minutnik zostanie zachowany."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start aftellen in Dayside. Een lopende timer blijft behouden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia un conto alla rovescia in Dayside. Un timer già in corso viene mantenuto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu đếm ngược trong Dayside. Hẹn giờ đang chạy (nếu có) sẽ được giữ lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayside’da bir geri sayım başlatır. Çalışan sayaç korunur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai hitung mundur di Dayside. Timer yang sedang berjalan tetap dipertahankan."
          }
        }
      }
    },
