        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근을 요청할 수 없습니다. 다시 시도하거나 시스템 설정에서 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff konnte nicht angefordert werden. Versuche es erneut oder prüfe ihn in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido solicitar acceso a los calendarios. Inténtalo de nuevo o compruébalo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l’accès aux calendriers. Réessayez ou vérifiez l’accès dans Réglages Système."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запросить доступ к календарям. Повторите попытку или проверьте доступ в Системных настройках."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível solicitar acesso aos calendários. Tente novamente ou verifique o acesso nos Ajustes do Sistema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można poprosić o dostęp do kalendarzy. Spróbuj ponownie lub sprawdź dostęp w Ustawieniach systemowych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot agenda's kon niet worden aangevraagd. Probeer het opnieuw of controleer de toegang in Systeeminstellingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile richiedere l’accesso ai calendari. Riprova o verifica l’accesso in Impostazioni di Sistema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể yêu cầu quyền truy cập lịch. Hãy thử lại hoặc kiểm tra quyền truy cập trong Cài đặt hệ thống."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim erişimi istenemedi. Yeniden deneyin veya Sistem Ayarları’nda erişimi denetleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat meminta akses kalender. Coba lagi atau periksa akses di Pengaturan Sistem."
          }
        }
      }
    },
