    "%1$@后午休，本机 %2$@ 恢复": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittagspause in %1$@, weiter um %2$@ auf diesem Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch break in %1$@; resumes at %2$@ on this Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa de mediodía dentro de %1$@; se reanuda a esta hora en este Mac: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause déjeuner dans %1$@, reprise à %2$@ sur ce Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@後に昼休み、このMacでは%2$@に再開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 후 점심 휴장, 이 Mac %2$@에 재개"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa do almoço em %1$@; retoma às %2$@ neste Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обеденный перерыв через %1$@; торги возобновятся в %2$@ по времени этого Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@后午休，本机%2$@恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@後午休，本機%2$@恢復"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa południowa za %1$@; wznowienie o %2$@ na tym Macu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Middagpauze over %1$@, weer open om %2$@ op deze Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa pranzo tra %1$@; riapre alle %2$@ su questo Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %1$@ nữa nghỉ trưa, giao dịch trở lại lúc %2$@ theo giờ máy Mac này"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sonra öğle arası; işlemler bu Mac’in saatiyle %2$@ itibarıyla yeniden başlar"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Istirahat siang %1$@ lagi; buka kembali pukul %2$@ di Mac ini"
          }
        }
      }
    },
