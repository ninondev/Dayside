    "落在这段本机时间里的候选排前面；不改变哪些时段可约。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落在这段本机时间里的候选排在前面，不改变哪些时段可选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落在這段本機時間裡的候選時段排在前面，不改變哪些時段可選。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Options that start in these hours on this Mac are listed first. This doesn’t change which times work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの時刻でこの時間枠に始まる候補を先に表示します。どの時間枠が選べるかは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간대(이 Mac 기준)에 해당하는 후보를 먼저 표시합니다. 선택 가능한 시간대는 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten in diesem Zeitraum auf diesem Mac werden zuerst angezeigt. Welche Zeiten verfügbar sind, bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones que empiezan dentro de este intervalo horario en este Mac aparecen primero; esto no cambia qué franjas están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les créneaux commençant dans cette plage horaire sur ce Mac sont affichés en premier ; cela ne change pas les créneaux disponibles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Варианты в этом диапазоне времени на Mac идут первыми; доступные варианты не меняются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções nesse intervalo de horário deste Mac aparecem primeiro; isso não altera quais horários podem ser escolhidos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj najpierw terminy przypadające w tych godzinach na tym Macu. Nie zmienia to dostępnych terminów"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opties die binnen dit tijdvak op deze Mac vallen, staan bovenaan. Dit verandert niet welke tijdvakken je kunt kiezen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proposte che iniziano in questa fascia (ora di questo Mac) vengono elencate per prime; non cambia quali fasce sono valide."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ưu tiên các lựa chọn bắt đầu trong khoảng giờ này theo giờ máy Mac này; các khung giờ có thể chọn không thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in saatiyle bu aralıkta olan seçenekler öne alınır; hangi saatlerin seçilebileceği değişmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utamakan kandidat dalam rentang waktu Mac ini; pilihan waktu yang tersedia tetap sama."
          }
        }
      }
    },
    "行程": {
