    "到达必须晚于或等于出发的实际时刻，请核对两地日期与时区。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达不能早于出发。请检查两地的日期和时区。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival can’t be before departure. Check the dates and time zones for both places."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達不能早於出發。請檢查兩地的日期和時區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着は出発より前にできません。両地点の日付と時間帯を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착은 출발보다 빠를 수 없습니다. 두 지역의 날짜와 시간대를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ankunft darf nicht vor der Abreise liegen. Prüfe Datum und Zeitzone beider Orte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llegada no puede ser anterior a la salida. Comprueba las fechas y zonas horarias de ambos lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrivée ne peut pas précéder le départ. Vérifiez les dates et les fuseaux horaires des deux lieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилёт не может быть раньше вылета. Проверьте даты и часовые пояса обоих мест."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chegada não pode ser anterior à partida. Confira as datas e os fusos horários dos dois locais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przylot nie może nastąpić przed wylotem. Sprawdź daty i strefy czasowe obu miejsc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankomst kan niet voor het vertrek vallen. Controleer de datums en tijdzones van beide locaties."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrivo non può precedere la partenza. Controlla date e fusi orari di entrambi i luoghi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ đến không được sớm hơn giờ khởi hành. Hãy kiểm tra ngày và múi giờ của cả hai nơi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varış, kalkıştan önce olamaz. İki konumun tarihlerini ve saat dilimlerini denetleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedatangan tidak boleh lebih awal dari keberangkatan. Periksa tanggal dan zona waktu kedua lokasi."
          }
        }
      }
    },
