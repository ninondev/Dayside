    "每个地方的几点，都在这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个地方的几点，都在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個地方的時間，都在這裡。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What time it is, everywhere you care about."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になる場所の“いま何時”を、ここに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 곳의 시간, 여기에서."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie spät es an jedem Ort ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de cada lugar, aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de chaque lieu, ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, сколько времени в каждом месте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora em cada local, aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj sprawdzisz, która jest godzina w każdym miejscu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe laat het overal is, zie je hier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che ore sono, in ogni luogo che ti sta a cuore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ ở mọi nơi, ngay tại đây."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerin saati burada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam berapa di setiap tempat, semuanya ada di sini."
          }
        }
      }
    },
    "每次调整添加为 1 小时的日历事件，备注写明当地时间的变化。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次换钟添加为1小时的日历事件，备注里写当地时间怎么变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each clock change is added as a one-hour event; the notes give the local times before and after."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次時鐘調整加入為1小時的行事曆行程，備註寫明當地時間的變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻変更ごとに1時間のカレンダー予定を追加し、メモに現地時刻の変化を記します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 시계 조정을 1시간짜리 캘린더 이벤트로 추가하며 메모에 현지 시각의 변화를 적습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Umstellung wird als einstündiger Kalendereintrag hinzugefügt; die Notizen geben die Ortszeiten vorher und nachher an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir cada cambio de hora como un evento de una hora, con las horas locales anterior y posterior en las notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement d’heure est ajouté comme évènement d’une heure ; les notes indiquent l’heure locale avant et après."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mudança é adicionada como um evento de uma hora; as notas indicam o horário local antes e depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый перевод часов добавляется как событие календаря на 1 час; в заметках указано местное время до и после перевода."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj każdą zmianę czasu jako godzinne wydarzenie w kalendarzu z opisem zmiany czasu lokalnego w notatkach"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke klokwijziging wordt als activiteit van 1 uur toegevoegd. In de notities staan de lokale tijden ervoor en erna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cambio dell’ora viene aggiunto come evento di un’ora; le note riportano l’ora locale prima e dopo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mỗi lần đổi giờ thành sự kiện lịch dài 1 giờ, với ghi chú về thay đổi giờ địa phương."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değişiklik 1 saatlik bir takvim etkinliği olarak eklenir; notlarda öncesi ve sonrası yerel saat yer alır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan setiap perubahan jam sebagai acara kalender berdurasi 1 jam, dengan catatan tentang perubahan waktu setempat."
          }
        }
      }
    },
