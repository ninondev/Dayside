    "%@ %@ 这段不存在（时钟拨快 %@）。请换一个时刻。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@这段不存在（时钟拨快%3$@）。请换一个时刻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@這段不存在（時鐘撥快%3$@）。請換一個時刻。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no %2$@ (clocks go forward %3$@). Choose another time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@では%2$@の時刻は存在しません（時計が%3$@進みます）。別の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 %2$@ 구간이 없습니다(시계를 %3$@ 앞당김). 다른 시각을 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$@ gibt es %2$@ nicht (die Uhr wird um %3$@ vorgestellt). Wähle eine andere Uhrzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$@ no existe %2$@ (el reloj se adelanta %3$@). Prueba con otra hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %1$@, %2$@ n’existe pas (l’horloge avance de %3$@). Essayez une autre heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: интервал %2$@ не существует (часы переводятся вперёд на %3$@). Укажите другое время."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário %2$@ não existe em %1$@ (os relógios avançam %3$@). Escolha outro horário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: przedział %2$@ nie istnieje (zegary przestawia się o %3$@ do przodu). Wybierz inną godzinę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$@ bestaat %2$@ niet (de klok gaat %3$@ vooruit). Kies een ander tijdstip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: l’intervallo %2$@ non esiste (le lancette vanno avanti di %3$@). Prova un altro orario."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không có khoảng %2$@ (đồng hồ được chỉnh tiến %3$@). Hãy chọn thời điểm khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ aralığı yok (saatler %3$@ ileri alınıyor). Başka bir saat deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di %1$@, rentang %2$@ tidak ada (jam dimajukan %3$@). Coba waktu lain."
          }
        }
      }
    },
