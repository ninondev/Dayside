        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "入睡和起床時間不能相同，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻と起床時刻は同じにできません。選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침과 기상 시각은 같을 수 없습니다. 다시 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafenszeit und Aufstehzeit dürfen nicht gleich sein. Wähle andere Zeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de dormir y la de despertar no pueden coincidir. Elige otras horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de coucher et de lever doivent être différentes. Choisissez d’autres horaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время засыпания не может совпадать со временем пробуждения. Выберите другое время."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários de dormir e acordar não podem ser iguais. Escolha horários diferentes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pora snu i pobudki nie mogą być takie same. Wybierz inne godziny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtijd en opstaantijd mogen niet gelijk zijn. Kies andere tijden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora di addormentamento e quella del risveglio non possono coincidere. Scegli orari diversi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ đi ngủ và giờ thức dậy không được trùng. Hãy chọn giờ khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma ve uyanma saati aynı olamaz. Farklı saatler seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tidur dan waktu bangun tidak boleh sama. Pilih waktu yang berbeda."
          }
        }
      }
    },
