          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona non lavora nei prossimi 14 giorni. Nessuna sveglia impostata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ander werkt de komende 14 dagen niet, dus er is geen wekker ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba nie pracuje przez najbliższe 14 dni, więc nie ustawiono budzika."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 14 gün boyunca çalışmıyor. Alarm kurulmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ không làm việc trong 14 ngày tới nên không đặt báo thức."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tersebut tidak bekerja dalam 14 hari ke depan, jadi alarm tidak diatur."
          }
        }
      }
    },
