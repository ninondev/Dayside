    "%@　调暗：室内光调暗，少看亮屏": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　调暗：室内光调暗，少看亮屏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Dim: lower the lights, keep screens dim"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　調暗：室內光調暗，少看亮螢幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　照明を落とす: 室内を暗めにし、明るい画面を控える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　조명 낮추기: 실내 조명을 어둡게 하고 밝은 화면 덜 보기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Приглушить свет: уменьшить освещение в помещении, меньше смотреть на яркие экраны"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Licht dimmen: Raumlicht dimmen, helle Bildschirme weniger nutzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Tamiser : réduire l’éclairage intérieur et limiter les écrans lumineux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Atenúa la luz interior y mira menos las pantallas brillantes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Reduzir a luz: diminuir a iluminação e evitar telas brilhantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Abbassa le luci: attenua l’illuminazione interna e usa meno gli schermi luminosi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Licht dimmen: dim het licht binnen en kijk minder naar heldere schermen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Przyciemnij: przyciemnij oświetlenie w pomieszczeniu i ogranicz patrzenie na jasne ekrany"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Işıkları kısın: iç mekân ışıklarını kısın ve parlak ekranlara daha az bakın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Giảm ánh sáng trong nhà, hạn chế nhìn màn hình sáng"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Redupkan: redupkan lampu dalam ruangan, kurangi melihat layar terang"
          }
        }
      }
    },
    "%@　避光：戴深色墨镜，少看亮屏": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　避光：戴深色墨镜，少看亮屏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Avoid light: dark sunglasses, keep screens dim"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　避光：戴深色墨鏡，少看亮螢幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　光を避ける: 濃いサングラスを着用し、明るい画面を控える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@　빛 피하기: 짙은 선글라스를 쓰고 밝은 화면 덜 보기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Избегать света: носить тёмные солнцезащитные очки, меньше смотреть на яркие экраны"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Licht meiden: dunkle Sonnenbrille tragen, helle Bildschirme weniger nutzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Éviter la lumière : porter des lunettes de soleil foncées et limiter les écrans lumineux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Evita la luz: usa gafas de sol oscuras y mira menos las pantallas brillantes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Evitar luz: óculos escuros e menos telas brilhantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Evita la luce: indossa occhiali da sole scuri e usa meno gli schermi luminosi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Licht vermijden: draag een donkere zonnebril en kijk minder naar heldere schermen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Unikaj światła: noś ciemne okulary przeciwsłoneczne i ogranicz patrzenie na jasne ekrany"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Işıktan kaçının: koyu camlı güneş gözlüğü takın ve parlak ekranlara daha az bakın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tránh ánh sáng, đeo kính râm tối màu, hạn chế nhìn màn hình sáng"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  Hindari cahaya: kenakan kacamata hitam gelap, kurangi melihat layar terang"
          }
        }
      }
    },
