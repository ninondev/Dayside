    "7 天内没有共同工作时段": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来7天没有共同工作时段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來7天沒有共同工作時段"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared work hours in the next 7 days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後7日間に共通の勤務時間はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 7일 동안 공통 근무 시간 없음"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gemeinsame Arbeitszeit in den nächsten 7 Tagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin horario laboral común en los próximos 7 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun créneau de travail commun dans les 7 prochains jours"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem horário de trabalho em comum nos próximos 7 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 7 дней нет общего рабочего времени"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wspólnych godzin pracy w ciągu najbliższych 7 dni"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen gezamenlijke werktijd in de komende 7 dagen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fascia di lavoro comune nei prossimi 7 giorni"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giờ làm việc chung trong 7 ngày tới"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 7 gün ortak çalışma saati yok"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada jam kerja bersama dalam 7 hari ke depan"
          }
        }
      }
    },
