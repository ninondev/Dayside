    "组合里要有 ⌥ 或 ⌃。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kürzel muss ⌥ oder ⌃ enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut needs ⌥ or ⌃."
          }
        },
