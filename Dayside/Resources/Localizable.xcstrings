            "value": "${sourceTimeZone} 기준 ${expression} 값을 저장한 장소의 시간으로 변환"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${expression} von ${sourceTimeZone} in die Ortszeiten der gespeicherten Orte umrechnen"
          }
        },
