          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum horário encontrado. Informe um horário e um local."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie rozpoznano godziny. Podaj godzinę i miejsce."
          }
        },
        "nl": {
          "stringUnit": {
