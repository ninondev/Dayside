    "请使用明确的时间和 IANA 时区标识，例如 14:00 Europe/Paris。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用明确的时间和IANA时区标识，例如 14:00 Europe/Paris。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an explicit time and IANA time zone, such as 14:00 Europe/Paris."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用明確的時間和IANA時區識別碼，例如14:00 Europe/Paris。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14:00 Europe/Parisのように、明確な時刻とIANA時間帯識別子を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14:00 Europe/Paris처럼 명확한 시각과 IANA 시간대 식별자를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine eindeutige Uhrzeit und IANA-Zeitzone, etwa 14:00 Europe/Paris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una hora explícita y un identificador de zona horaria IANA, por ejemplo, 14:00 Europe/Paris."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une heure explicite et un identifiant de fuseau horaire IANA, par exemple 14:00 Europe/Paris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите точное время и идентификатор часового пояса IANA, например 14:00 Europe/Paris."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um horário explícito e um identificador de fuso IANA, como 14:00 Europe/Paris."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj dokładną godzinę i strefę czasową IANA, np. 14:00 Europe/Paris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een duidelijke tijd en IANA-tijdzone-ID, zoals 14:00 Europe/Paris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un orario esplicito e un identificativo di fuso orario IANA, ad esempio 14:00 Europe/Paris."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng giờ cụ thể và mã định danh múi giờ IANA, ví dụ 14:00 Europe/Paris."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin bir saat ve IANA saat dilimi tanımlayıcısı kullanın, örneğin 14:00 Europe/Paris."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan waktu yang jelas dan pengenal zona waktu IANA, misalnya 14:00 Europe/Paris."
          }
        }
      }
    },
    "请先保存至少两个地点，并输入 15 至 480 分钟的时长。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存至少两个地点，并输入15至480分钟的时长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save at least two places and enter a duration from 15 to 480 minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先儲存至少兩個地點，並輸入15至480分鐘的時間長度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を2つ以上保存し、15〜480分の所要時間を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 두 개 이상 저장하고 15~480분 사이의 시간을 입력하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere mindestens zwei Orte und gib eine Dauer von 15 bis 480 Minuten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda al menos dos lugares e introduce una duración de 15 a 480 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez au moins deux lieux et saisissez une durée de 15 à 480 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните не менее двух мест и укажите длительность от 15 до 480 минут."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve pelo menos dois locais e informe uma duração de 15 a 480 minutos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj co najmniej dwa miejsca i wpisz czas trwania od 15 do 480 minut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar minstens twee locaties en voer een duur in van 15 tot 480 minuten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva almeno due luoghi e inserisci una durata tra 15 e 480 minuti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy lưu ít nhất hai địa điểm và nhập thời lượng từ 15 đến 480 phút."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en az iki konum kaydedin ve 15 ile 480 dakika arasında bir süre girin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan setidaknya dua lokasi terlebih dahulu, dan masukkan durasi 15 hingga 480 menit."
          }
        }
      }
    },
    "请至少选择一天。": {
      "localizations": {
