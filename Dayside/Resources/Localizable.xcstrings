    "添加地点后，这里会生成给 iPhone 扫的二维码。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加地点后，这里会生成给iPhone扫的二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增地點後，這裡會產生給iPhone掃的QR碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a place to get a QR code for your iPhone here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を追加すると、iPhoneで読み取るQRコードがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 추가하면 iPhone으로 스캔할 QR 코드가 여기에 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ort hinzu, dann erscheint hier ein QR-Code für dein iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un lugar y aquí aparecerá un código QR para escanearlo con el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un lieu : un code QR pour votre iPhone apparaîtra ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um local e um código QR para o seu iPhone aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте место, и здесь появится QR-код для Вашего iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj miejsce, a tutaj pojawi się kod QR do zeskanowania iPhone’em."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een locatie toe, dan verschijnt hier een QR-code voor je iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un luogo e qui comparirà un codice QR per iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm một địa điểm để tạo mã QR cho iPhone quét tại đây."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum ekleyince iPhone ile taranacak QR kodu burada görünür."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan lokasi, dan kode QR untuk iPhone akan muncul di sini."
          }
        }
      }
    },
