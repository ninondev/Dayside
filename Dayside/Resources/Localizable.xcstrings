          "stringUnit": {
            "state": "translated",
            "value": "身体还差%@；这几晚没有要特别晒光或避光的时段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body clock still %@ off; nothing special to do about light these nights."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生理時鐘還差%@；這幾晚沒有需要特別接觸光線或避光的時段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体内時計はまだ%@ずれています。この数晩は、光を浴びる・避ける時間の指定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생체 시계가 아직 %@ 차이 납니다. 이 며칠 밤에는 특별히 빛을 쬐거나 피할 시간대가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внутренним часам осталось сдвинуться на %@; в эти ночи нет особых периодов для пребывания на свету или его избегания."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die innere Uhr weicht noch um %@ ab; in diesen Nächten gibt es keine besonderen Zeiten für helles Licht oder zum Meiden von Licht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge interne a encore %@ de décalage ; ces nuits-là, aucun créneau particulier ne nécessite de s’exposer à la lumière ou de l’éviter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj biológico aún tiene %@ de desfase; estas noches no hay periodos especiales para buscar o evitar la luz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio biológico ainda tem %@ de diferença; nestas noites não há períodos especiais para buscar ou evitar luz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’orologio biologico ha ancora una differenza di %@; in queste notti non ci sono fasce particolari per esporsi alla luce o evitarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lichaamsklok wijkt nog %@ af. Deze nachten zijn er geen speciale tijden om licht op te zoeken of te vermijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar biologiczny nadal różni się o %@; w te noce nie ma wyznaczonych pór korzystania ze światła ani jego unikania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut saatinde hâlâ %@ fark var. Bu gecelerde ışık almak veya ışıktan kaçınmak için özel bir zaman aralığı yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ sinh học còn lệch %@; những đêm này không có khung giờ đặc biệt để tiếp xúc hoặc tránh ánh sáng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam biologis masih berselisih %@; malam-malam ini tidak ada waktu khusus untuk mencari atau menghindari cahaya."
          }
        }
      }
    },
