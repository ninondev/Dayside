    "时钟调整会改变这些会议的当地时间": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换钟会挪动这些例会的当地时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時鐘調整會改變這些例行會議的當地時間"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock changes will move these meetings’ local times"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻変更でこれらの定期的な会議の現地時間が変わります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 조정으로 이 정기 회의들의 현지 시간이 바뀝니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitumstellungen verschieben die Ortszeit dieser wiederkehrenden Besprechungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de hora desplazarán la hora local de estas reuniones periódicas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements d’heure décaleront l’heure locale de ces réunions récurrentes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод часов сдвинет местное время этих повторяющихся встреч"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mudanças de horário vão alterar o horário local destas reuniões recorrentes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany czasu przesuną czas lokalny tych cyklicznych spotkań"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
