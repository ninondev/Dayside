          }
        }
      }
    },
    "这个当地时刻不存在，可能处于夏令时跳转。请换一个时刻。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ortszeit existiert nicht; möglicherweise wurde sie bei einer Zeitumstellung übersprungen. Wähle eine andere Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local time doesn’t exist; a clock change may have skipped it. Choose another time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta hora local no existe; es posible que un cambio de hora la haya omitido. Elige otra hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure locale n’existe pas ; elle a peut-être été omise lors d’un changement d’heure. Choisissez une autre heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この現地時刻は存在しません。時刻変更で飛ばされた可能性があります。別の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 현지 시각은 존재하지 않습니다. 시계 조정으로 건너뛰었을 수 있습니다. 다른 시각을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse horário local não existe; a mudança de horário pode tê-lo pulado. Escolha outro horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такого местного времени не существует — возможно, оно пропущено при переводе часов. Выберите другое."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個當地時刻不存在，可能是時鐘調整時跳過了。請換一個時刻。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个当地时刻不存在，可能是换钟时跳过了。请换一个时刻。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta godzina lokalna nie istnieje; mogła zostać pominięta przez zmianę czasu. Wybierz inną godzinę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze lokale tijd bestaat niet, mogelijk door een klokwijziging. Kies een ander tijdstip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest’ora locale non esiste; un cambio dell’ora potrebbe averla saltata. Scegli un altro orario."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ địa phương này không tồn tại, có thể do đổi giờ đã bỏ qua. Hãy chọn thời điểm khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerel saat mevcut değil; saat değişikliğinde atlanmış olabilir. Başka bir saat seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu setempat ini tidak ada; perubahan jam mungkin telah melewatinya. Pilih waktu lain."
          }
        }
      }
    },
    "这个组合已被其他 App 占用，换一个。": {
