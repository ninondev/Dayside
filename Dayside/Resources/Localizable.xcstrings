    "月相按所选日期当地中午计算": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月相按所选日期当地中午计算"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon phase is for local noon on the selected date"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月相依所選日期當地中午計算"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月相は選択した日付の現地正午で計算します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달의 위상은 선택한 날짜의 현지 정오 기준입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondphase berechnet für den Ortsmittag des gewählten Tages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fase lunar se calcula para el mediodía local de la fecha seleccionada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phase lunaire est calculée à midi, heure locale du jour choisi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фаза Луны — на местный полдень выбранного дня"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fase da Lua é calculada para o meio-dia local na data selecionada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fase lunare è calcolata a mezzogiorno locale della data selezionata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maanfase wordt berekend voor het lokale middaguur op de gekozen datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Faza Księżyca jest obliczana dla lokalnego południa wybranego dnia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay evresi, seçili tarihin yerel öğle saatine göre hesaplanır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần trăng tính vào giữa trưa theo giờ địa phương của ngày đã chọn"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase bulan dihitung pada tengah hari waktu setempat pada tanggal yang dipilih"
          }
        }
      }
    },
    "未来14天里对方都不上班，没有设闹钟。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来14天里对方都不上班，没有设闹钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They don’t start work in the next 14 days, so no alarm was set."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來14天裡對方都不上班，沒有設定鬧鐘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後14日間に相手の始業がないため、アラームは設定していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 14일 동안 출근하지 않아 알람을 설정하지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
