          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные городов отсутствуют, поиск недоступен. Переустановите Dayside."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
