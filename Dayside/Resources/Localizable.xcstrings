    "两地钟面一致，不需要按光照调整。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两地钟点一样，不用调整作息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩地時間一致，不需要調整作息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both places show the same time, so there’s nothing to adjust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両地点の時刻は同じなので、調整は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 곳의 시각이 같아 조정할 필요가 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Orte haben dieselbe Uhrzeit; es ist keine Anpassung nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos lugares tienen la misma hora; no hay nada que ajustar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux lieux ont la même heure ; rien à ajuster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В обоих местах одинаковое время, корректировка не нужна."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois locais mostram a mesma hora; não é preciso ajustar a rotina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba miejsca mają ten sam czas, więc nie trzeba nic dostosowywać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide locaties hebben dezelfde kloktijd, dus aanpassing is niet nodig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I due luoghi hanno la stessa ora, non c’è nulla da regolare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai nơi cùng giờ, không cần điều chỉnh lịch sinh hoạt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki konumun saati aynı; günlük düzeninizi değiştirmeniz gerekmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu di kedua lokasi sama, jadi tidak perlu penyesuaian."
          }
        }
      }
    },
