    "该地点没有这个时刻，请调整日期或时间。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地点没有这个时刻，请调整日期或时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time doesn’t exist at that place. Adjust the date or time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該地點沒有這個時刻，請調整日期或時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場所にこの時刻は存在しません。日付または時刻を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 장소에 이 시각은 존재하지 않습니다. 날짜나 시간을 조정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhrzeit existiert an diesem Ort nicht. Passe Datum oder Uhrzeit an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta hora no existe en ese lugar. Ajusta la fecha o la hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure n’existe pas à cet endroit. Modifiez la date ou l’heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месте такого времени не существует. Измените дату или время."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse horário não existe nesse local. Ajuste a data ou a hora."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta godzina nie istnieje w tym miejscu. Zmień datę lub godzinę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tijd bestaat niet op die locatie. Pas de datum of tijd aan."
          }
        },
        "it": {
