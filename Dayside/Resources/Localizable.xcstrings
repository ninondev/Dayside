        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una ciudad en el panel para verla en este mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une ville dans le panneau pour la voir sur cette carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте город в панели, чтобы увидеть его на этой карте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma cidade no painel para vê-la neste mapa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj miasto w panelu, a pojawi się na tej mapie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een stad toe in het paneel, dan verschijnt die op deze kaart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una città nel pannello per vederla su questa mappa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm thành phố trong bảng để nó xuất hiện trên bản đồ này."
          }
