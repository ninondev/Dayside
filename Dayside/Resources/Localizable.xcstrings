          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym wydarzeniu nie znaleziono rozpoznawalnego łącza do spotkania Zoom, Google Meet ani Microsoft Teams."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze activiteit bevat geen herkenbare deelnamelink voor Zoom, Google Meet of Microsoft Teams."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo evento non è stato trovato un link riconoscibile per partecipare a Zoom, Google Meet o Microsoft Teams."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện này không có liên kết tham gia Zoom, Google Meet hoặc Microsoft Teams mà ứng dụng nhận dạng được."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etkinlikte tanınabilir bir Zoom, Google Meet veya Microsoft Teams katılma bağlantısı yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan tautan gabung Zoom, Google Meet, atau Microsoft Teams yang dapat dikenali di acara ini."
          }
        }
      }
    },
    "每 4 轮后安排长休息，最后一轮结束后停止。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每4轮一次长休息，最后一轮结束就停。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long break every four rounds. Stops after the last round."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每4輪一次長休息，最後一輪結束就停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4回ごとに長い休憩を取り、最終回の後に停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4회차마다 긴 휴식을 넣고 마지막 회차가 끝나면 멈춥니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4 Runden eine lange Pause. Nach der letzten Runde endet der Timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso largo cada 4 rondas. Se detiene tras la última."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause longue tous les 4 cycles. Arrêt après le dernier cycle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинный перерыв каждые 4 цикла. После последнего цикла отсчёт останавливается."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pausa longa a cada 4 ciclos. O timer para ao fim do último ciclo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po każdych czterech rundach następuje długa przerwa. Po ostatniej rundzie odliczanie się kończy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke 4 rondes een lange pauze. Stopt na de laatste ronde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa lunga ogni 4 cicli. Si ferma dopo l’ultimo ciclo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau mỗi 4 vòng có một lần nghỉ dài. Dừng sau vòng cuối."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her 4 turdan sonra uzun mola. Son turdan sonra durur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Istirahat panjang setelah setiap 4 putaran. Berhenti setelah putaran terakhir."
          }
        }
      },
      "extractionState": "manual"
    },
    "每两周": {
