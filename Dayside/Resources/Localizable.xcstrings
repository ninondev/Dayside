    "旅行存档版本较新，更新 Dayside 后再编辑。原始数据已保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行数据由较新版本的Dayside保存，更新后才能编辑。原始数据已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel data was saved by a newer version of Dayside. Update Dayside to edit it. The original data is kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行資料由較新版本的Dayside儲存，更新後才能編輯。原始資料已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行データは、より新しいバージョンのDaysideで保存されています。編集するにはDaysideをアップデートしてください。元のデータは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 데이터는 더 새로운 버전의 Dayside에서 저장되었습니다. 편집하려면 Dayside를 업데이트하세요. 원본 데이터는 보존됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Reisedaten wurden mit einer neueren Version von Dayside gesichert. Aktualisiere Dayside, um sie zu bearbeiten. Die Originaldaten bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de viajes se han guardado con una versión más reciente de Dayside. Actualiza Dayside para editarlos. Los datos originales se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des voyages ont été enregistrées par une version plus récente de Dayside. Mettez Dayside à jour pour les modifier. Les données d’origine ont été conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные поездок сохранены в более новой версии Dayside. Обновите Dayside, чтобы редактировать их. Исходные данные сохранены."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de viagens foram salvos por uma versão mais recente do Dayside. Atualize o Dayside para editar. Os dados originais foram preservados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane podróży zachowano w nowszej wersji aplikacji Dayside. Uaktualnij aplikację Dayside, aby je edytować. Oryginalne dane zachowano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reisgegevens zijn bewaard door een nieuwere versie van Dayside. Werk Dayside bij om ze te bewerken. De oorspronkelijke gegevens zijn behouden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati dei viaggi sono stati salvati da una versione più recente di Dayside. Aggiorna Dayside per modificarli. I dati originali sono conservati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu chuyến đi được lưu bằng phiên bản Dayside mới hơn. Hãy cập nhật Dayside trước khi sửa. Dữ liệu gốc vẫn được giữ nguyên."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyahat verileri Dayside’ın daha yeni bir sürümüyle kaydedilmiş. Düzenlemek için Dayside’ı güncelleyin. Özgün veriler korundu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data perjalanan disimpan oleh versi Dayside yang lebih baru. Perbarui Dayside untuk mengeditnya. Data asli tetap tersimpan."
          }
        }
      }
    },
    "无法保存，请重新打开编辑。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存，请重新打开编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save. Reopen the editor and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存，請重新打開編輯畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。編集画面を開き直してやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 수 없습니다. 편집 화면을 다시 열고 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern fehlgeschlagen. Öffne die Bearbeitung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar. Abre de nuevo el editor e inténtalo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer. Rouvrez l’éditeur et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Откройте редактор заново."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Reabra a edição e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować zmian. Otwórz ponownie okno edycji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bewaren is mislukt. Open het bewerkvenster opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare. Riapri l’editor e riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu. Hãy mở lại phần chỉnh sửa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilemedi. Düzenleyiciyi kapatıp yeniden açın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan. Buka kembali untuk mengedit."
          }
        }
      }
    },
    "无法打开会议链接。请检查默认浏览器后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开会议链接。请检查默认浏览器后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the meeting link. Check your default browser and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開會議連結。請檢查預設瀏覽器後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議のリンクを開けませんでした。デフォルトブラウザを確認してから、やり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 링크를 열 수 없습니다. 기본 브라우저를 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Besprechungslink konnte nicht geöffnet werden. Prüfe deinen Standardbrowser und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el enlace de la reunión. Comprueba el navegador predeterminado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le lien de la réunion. Vérifiez votre navigateur par défaut et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть ссылку на встречу. Проверьте браузер по умолчанию и повторите попытку."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o link da reunião. Verifique o navegador padrão e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć łącza do spotkania. Sprawdź domyślną przeglądarkę i spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergaderlink kon niet worden geopend. Controleer je standaardbrowser en probeer het opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il link della riunione. Verifica il browser di default e riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở liên kết cuộc họp. Hãy kiểm tra trình duyệt mặc định và thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı bağlantısı açılamadı. Saptanmış tarayıcınızı denetleyip yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuka tautan rapat. Periksa browser default Anda dan coba lagi."
          }
        }
      }
    },
    "无法生成这次旅行的作息表，请检查时区、日期和睡眠时间。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成这次旅行的作息表，请检查地点、日期和睡眠时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create a sleep plan for this trip. Check the places, dates, and sleep times."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法產生這次旅行的作息表，請檢查地點、日期和睡眠時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この旅行の睡眠スケジュールを作成できませんでした。場所、日付、睡眠時間を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 여행의 일과표를 만들 수 없습니다. 장소, 날짜, 수면 시간을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlafplan für diese Reise konnte nicht erstellt werden. Prüfe Orte, Daten und Schlafzeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido generar el horario de sueño para este viaje. Comprueba los lugares, las fechas y las horas de sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le programme de sommeil pour ce voyage. Vérifiez les lieux, les dates et les heures de sommeil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось составить распорядок для этой поездки. Проверьте места, даты и время сна."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar a rotina desta viagem. Confira os locais, as datas e os horários de sono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć planu snu dla tej podróży. Sprawdź miejsca, daty i godziny snu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen slaapschema voor deze reis maken. Controleer de locaties, datums en slaaptijden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare il piano del sonno per questo viaggio. Controlla luoghi, date e orari di sonno."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo lịch sinh hoạt cho chuyến đi này. Hãy kiểm tra địa điểm, ngày và giờ ngủ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seyahat için uyku planı oluşturulamadı. Konumları, tarihleri ve uyku saatlerini denetleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuat jadwal tidur untuk perjalanan ini. Periksa lokasi, tanggal, dan jam tidur."
          }
        }
      }
    },
    "无法识别时间，请输入明确日期、时刻和时区。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没读到时间，请写上钟点和地点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time found. Include a time and a place."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒讀到時間，請寫上時間和地點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻が見つかりません。時刻と場所を入力してください。"
