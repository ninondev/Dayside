        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy đổi ${expression} từ ${sourceTimeZone} sang các địa điểm đã lưu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "${expression} ifadesini ${sourceTimeZone} saat diliminden kayıtlı konumlara dönüştür"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversi ${expression} dari ${sourceTimeZone} ke lokasi tersimpan"
          }
        }
