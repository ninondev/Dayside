    "无法保存文件。请选择可写入的位置后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存文件。请选择可写入的位置后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the file. Choose a location you can write to and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存檔案。請選擇可寫入的位置後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを保存できませんでした。書き込み可能な場所を選んでやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 저장할 수 없습니다. 쓰기 가능한 위치를 선택한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gesichert werden. Wähle einen beschreibbaren Speicherort und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el archivo. Elige una ubicación donde puedas escribir e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le fichier. Choisissez un emplacement accessible en écriture et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить файл. Выберите место, доступное для записи, и повторите попытку."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o arquivo. Escolha um local com permissão de gravação e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować pliku. Wybierz folder z prawem zapisu i spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kon niet worden bewaard. Kies een schrijfbare locatie en probeer het opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il file. Scegli una posizione accessibile in scrittura e riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu tệp. Hãy chọn vị trí có thể ghi rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kaydedilemedi. Yazma izni olan bir konum seçip yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak dapat disimpan. Pilih folder yang dapat ditulisi, lalu coba lagi."
          }
        }
      }
    },
