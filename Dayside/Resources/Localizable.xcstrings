          "stringUnit": {
            "state": "translated",
            "value": "Convertir ${expression} du fuseau horaire ${sourceTimeZone} vers ceux des lieux enregistrés"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересчитать ${expression} из часового пояса ${sourceTimeZone} для сохранённых мест"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter ${expression} de ${sourceTimeZone} para os locais salvos"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelicz ${expression} na czas zachowanych miejsc (strefa źródłowa: ${sourceTimeZone})"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reken ${expression} om van ${sourceTimeZone} naar je bewaarde locaties"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converti ${expression} da ${sourceTimeZone} agli orari dei luoghi salvati"
          }
