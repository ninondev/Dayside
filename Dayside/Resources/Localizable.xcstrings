    "暂未查到这些地点的下一次时钟调整。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些地点暂时没有查到下一次换钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upcoming clock changes found for these places."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫未查到這些地點的下一次時鐘調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの場所で、次の時刻変更は見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장소들의 다음 시계 조정을 아직 찾지 못했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Orte wurde keine nächste Zeitumstellung gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado próximos cambios de hora para estos lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun changement d’heure à venir n’a été trouvé pour ces lieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий перевод часов для этих мест пока не найден."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi encontrada a próxima mudança de horário desses locais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono najbliższych zmian czasu dla tych miejsc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aanstaande klokwijzigingen gevonden voor deze locaties."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questi luoghi non è stato trovato il prossimo cambio dell’ora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy lần đổi giờ sắp tới cho các địa điểm này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konumlar için yaklaşan saat değişikliği bulunamadı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ditemukan perubahan jam mendatang untuk lokasi ini."
          }
        }
      }
    },
    "未来 12 个月各地与本机的时差都不变。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来12个月各地与本机的时差都不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來12個月各地與本機的時差都不變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time differences from this Mac change in the next 12 months."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後12か月、どの場所もこのMacとの時差は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 12개월 동안 이 Mac과의 시차는 변하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 12 Monaten ändert sich der Zeitunterschied zu diesem Mac an keinem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los próximos 12 meses la diferencia horaria con este Mac no cambia en ningún lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun décalage avec ce Mac ne change dans les 12 prochains mois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos próximos 12 meses, a diferença de horário com este Mac não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 12 месяцев разница во времени с этим Mac ни для одного места не изменится."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu najbliższych 12 miesięcy różnica czasu względem tego Maca nie zmieni się w żadnym miejscu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de komende 12 maanden verandert het tijdsverschil met deze Mac voor geen enkele locatie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei prossimi 12 mesi la differenza oraria con questo Mac non cambia per nessun luogo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong 12 tháng tới, chênh lệch giờ giữa các nơi và máy Mac này không đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 12 ayda hiçbir konumun bu Mac ile saat farkı değişmiyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selisih waktu setiap lokasi dengan Mac ini tidak berubah dalam 12 bulan ke depan."
          }
        }
      }
    },
