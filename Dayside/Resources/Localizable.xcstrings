          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho precisa de ⌥ ou ⌃."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сочетании должна быть клавиша ⌥ или ⌃."
          }
