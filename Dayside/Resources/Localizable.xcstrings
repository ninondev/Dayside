    "核对本机时区数据是否落后于已知的时区规则变更。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对本机时区数据是否落后于已知的时区规则变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核對本機時區資料是否落後於已知的時區規則變更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether this Mac’s time zone data is behind known time zone rule changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの時間帯データが既知のルール変更より古くないか確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 시간대 데이터가 알려진 시간대 규칙 변경보다 오래되었는지 확인합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob die Zeitzonendaten dieses Mac hinter bekannten Regeländerungen zurückliegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si los datos de zonas horarias de este Mac van por detrás de los cambios de reglas conocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si les données de fuseaux horaires de ce Mac sont en retard sur les changements de règles connus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, не отстают ли данные часовых поясов этого Mac от известных изменений правил."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se os dados de fusos horários deste Mac estão atrasados em relação às alterações de regras conhecidas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdza, czy dane stref czasowych na tym Macu uwzględniają znane zmiany reguł stref czasowych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert of de tijdzonegegevens van deze Mac achterlopen op bekende wijzigingen in tijdzoneregels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se nei dati dei fusi orari di questo Mac mancano modifiche note alle regole dei fusi orari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xem dữ liệu múi giờ của máy Mac này có chậm hơn các thay đổi quy tắc múi giờ đã biết hay không."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’teki saat dilimi verilerinin bilinen saat dilimi kuralı değişikliklerinin gerisinde kalıp kalmadığını denetler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa apakah data zona waktu Mac ini tertinggal dari perubahan aturan zona waktu yang diketahui."
          }
        }
      }
    },
