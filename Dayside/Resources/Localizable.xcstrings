    "操作未完成，请打开 Dayside 后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成，请打开Dayside后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action didn’t finish. Open Dayside and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成，請打開Dayside後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした。Daysideを開いてやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작을 완료하지 못했습니다. Dayside를 열고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion wurde nicht abgeschlossen. Öffne Dayside und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción no se ha completado. Abre Dayside e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action n’a pas abouti. Ouvrez Dayside et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие не завершено. Откройте Dayside и повторите."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não foi concluída. Abra o Dayside e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć czynności. Otwórz aplikację Dayside i spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie is niet voltooid. Open Dayside en probeer het opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azione non completata. Apri Dayside e riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác vụ chưa hoàn tất. Hãy mở Dayside rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanamadı. Dayside’ı açıp yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tidak selesai. Buka Dayside, lalu coba lagi."
          }
