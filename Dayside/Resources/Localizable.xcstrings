          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun début de travail dans les 14 prochains jours ; aucune alarme n’a été programmée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 14 дней у этого человека нет рабочих дней, поэтому будильник не установлен."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
