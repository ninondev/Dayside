        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“내 시간”은 %1$@ 기준으로 계산합니다. 같은 줄의 %2$@에서 추정했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Meine Zeit“ gilt als %1$@: aus %2$@ in derselben Zeile geschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mi hora” se calcula según %1$@: se deduce de %2$@ en la misma línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour « Mon heure », le calcul utilise %1$@, d’après %2$@ sur la même ligne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Моё время» определяется так: %1$@ (основание: %2$@ в той же строке)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Meu horário” usa %1$@, com base em %2$@ na mesma linha"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„U mnie” odczytano jako %1$@: wywnioskowano z %2$@ w tym samym wierszu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Mijn tijd' wordt opgevat als %1$@: afgeleid van %2$@ op dezelfde regel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“La mia ora” è calcolata come %1$@: dedotta da %2$@ sulla stessa riga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Giờ bên tôi” được tính theo %1$@: suy ra từ %2$@ trên cùng một dòng"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Benim saatimle” için %1$@ kullanılıyor; aynı satırdaki %2$@ ifadesinden çıkarıldı"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Waktu saya” dihitung sebagai %1$@: disimpulkan dari %2$@ pada baris yang sama"
          }
        }
      }
    },
