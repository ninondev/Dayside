        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared work hours in the next 7 days."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來7天沒有共同工作時段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後7日間に共通の勤務時間はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 7일 동안 공통 근무 시간이 없습니다."
          }
        },
        "de": {
          "stringUnit": {
