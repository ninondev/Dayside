    "只换算，不建议改时间；表中是到达日起一周内的目的地当地时间。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnet nur Zeiten um und empfiehlt keine Änderung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion only, no advice to change times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se hace la conversión, sin recomendar cambios de hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion uniquement, sans conseil pour modifier vos horaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換のみで、時刻の変更は勧めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간만 변환하며, 시각을 바꾸도록 권하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas converte os horários, sem sugerir alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только пересчёт времени, без советов менять его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只换算，不建议改时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只換算，不建議更改時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko przeliczanie, bez zalecania zmiany godzin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen tijdconversie, geen advies om tijden te wijzigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo conversione, senza consigli su come cambiare gli orari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quy đổi, không khuyên thay đổi giờ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca dönüştürme, saat değiştirme önerisi yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya konversi, tanpa saran untuk mengubah waktu."
          }
        }
      }
    },
    "只移除 Dayside 中的记录，不会修改通讯录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除Dayside里的记录，不会改动通讯录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the record in Dayside is deleted. Your contacts aren’t changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪除Dayside中的紀錄，不會修改聯絡人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayside内の記録のみ削除します。連絡先は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayside의 기록만 삭제됩니다. 연락처는 변경되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht nur den Eintrag in Dayside. Die Kontakte werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el registro de Dayside. Los contactos no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l’enregistrement dans Dayside est supprimé. Vos contacts ne sont pas modifiés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется только запись в Dayside. Контакты не изменяются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o registro no Dayside é apagado. Seus contatos não são alterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięty zostanie tylko wpis w aplikacji Dayside; Kontakty pozostaną bez zmian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het item in Dayside wordt verwijderd. Je contacten worden niet gewijzigd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eliminata solo la voce in Dayside. I contatti non vengono modificati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xóa bản ghi trong Dayside. Danh bạ không bị thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Dayside’daki kayıt silinir. Kişileriniz değiştirilmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya catatan di Dayside yang akan dihapus. Kontak tidak akan diubah."
          }
        }
      }
    },
