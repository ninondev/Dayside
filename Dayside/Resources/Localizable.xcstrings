            "value": "Tego klawisza nie można użyć w skrócie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toets kan niet in een toetscombinatie worden gebruikt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tasto non può essere usato in un’abbreviazione."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng phím này trong phím tắt."
          }
        },
        "tr": {
          "stringUnit": {
