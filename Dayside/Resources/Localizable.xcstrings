    "未能执行操作，请检查地点或计时器状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成操作，请检查地点或计时器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the action. Check the place or timer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成操作，請檢查地點或計時器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした。場所またはタイマーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작을 완료할 수 없습니다. 장소 또는 타이머를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion konnte nicht ausgeführt werden. Prüfe den Ort oder den Timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar la acción. Comprueba el lugar o el temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’action. Vérifiez le lieu ou le minuteur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие. Проверьте место или таймер."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível completar a ação. Verifique o local ou o timer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wykonać czynności. Sprawdź miejsce lub minutnik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de actie niet voltooien. Controleer de locatie of timer."
          }
        },
