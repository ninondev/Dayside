    "这几场都不在工作时段内的人：%@。可以放宽范围。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这几场都不在工作时段内的人：%@。可以放宽范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No session is within work hours for: %@. Try a wider range."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這幾場都不在工作時段內的人：%@。可以放寬範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの回も勤務時間外になる人: %@。範囲を広げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 회차가 근무 시간 밖인 참가자: %@. 범위를 넓혀 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Personen liegt keiner der Ereignisse innerhalb der Arbeitszeiten: %@. Versuche einen größeren Zeitraum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna sesión cae dentro del horario laboral de estas personas: %@. Prueba con un intervalo más amplio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ces personnes, aucune séance ne tombe pendant leurs horaires de travail : %@. Essayez une plage plus large."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна встреча не приходится на рабочее время у следующих участников: %@. Попробуйте расширить диапазон."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sessão cai no horário de trabalho destas pessoas: %@. Tente um intervalo maior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sessione rientra nell’orario di lavoro di %@. Prova con un intervallo più ampio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze personen valt geen enkele sessie binnen de werktijden: %@. Probeer een ruimere periode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, dla których żadna tura nie wypada w godzinach pracy: %@. Spróbuj rozszerzyć zakres."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir oturumda çalışma saatleri içinde olmayan kişiler: %@. Aralığı genişletmeyi deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với những người này, các phiên đều nằm ngoài giờ làm việc: %@. Hãy thử mở rộng phạm vi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sesi ini berada di luar jam kerja orang berikut: %@. Coba perluas rentangnya."
          }
        }
      }
    },
