    "添加姓名、所在地和作息，查看当地时间与工作状态。无需通讯录权限。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加同事或家人，看他们那边几点、在不在上班。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add colleagues or family to see their time and whether they’re at work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增同事或家人，查看對方當地時間與工作狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同僚や家族を追加して、相手の時刻や勤務中かどうかを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동료나 가족을 추가하면 그곳의 시간과 근무 여부를 확인할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Personen aus deinem Arbeits- oder Familienkreis hinzu, um ihre Ortszeit zu sehen und zu prüfen, ob sie bei der Arbeit sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade compañeros de trabajo o familiares para ver su hora y si están trabajando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des collègues ou de la famille pour voir leur heure et s’ils travaillent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте коллег или родных, чтобы видеть, сколько у них времени и работают ли они сейчас."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione colegas ou familiares para ver o horário local e se estão trabalhando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj współpracowników lub członków rodziny, aby sprawdzić, która jest u nich godzina i czy są w pracy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg collega's of familieleden toe om te zien hoe laat het bij hen is en of ze aan het werk zijn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi colleghi o familiari per vedere che ora è da loro e se sono al lavoro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm đồng nghiệp hoặc người thân để xem giờ bên họ và họ có đang làm việc không."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş arkadaşlarınızı veya ailenizi ekleyerek bulundukları yerde saatin kaç olduğunu ve çalışıp çalışmadıklarını görün."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan rekan kerja atau keluarga untuk melihat waktu dan status kerja mereka."
          }
        }
      }
    },
