    "系统提醒只安排最近 %lld 次变化。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只为最近%lld次换钟安排提醒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are scheduled only for the next %lld clock changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只為接下來%lld次時鐘調整安排提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を設定するのは、次の%lld回の時刻変更のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 시계 조정 %lld건에만 알림을 예약합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden nur für die nächsten %lld Umstellungen geplant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se programan avisos para los siguientes cambios de hora: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels couvrent les prochains changements d’heure, dans la limite de %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания запланированы только на ближайшие переводы часов (количество: %lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas são agendados apenas para as próximas mudanças de horário, até o limite de %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia obejmują tylko najbliższe zmiany czasu (liczba: %lld)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwingen worden alleen gepland voor de eerstvolgende %lld klokwijzigingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si programmano avvisi solo per i prossimi cambi dell’ora: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lên lịch nhắc cho %lld lần đổi giờ sắp tới."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar yalnızca sonraki %lld saat değişikliği için planlanır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat hanya dijadwalkan untuk %lld perubahan jam berikutnya."
          }
        }
      }
    },
    "系统未允许通知，界面仍可使用。可在系统设置中允许 Dayside 通知。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未开启。请在系统设置里允许Dayside发通知。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Allow Dayside to send notifications in System Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未開啟。請在「系統設定」中允許Dayside發送通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は許可されていません。システム設定でDaysideの通知を許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 시스템 설정에서 Dayside 알림을 허용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Erlaube Dayside-Mitteilungen in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permite que Dayside envíe notificaciones en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez Dayside à envoyer des notifications dans Réglages Système."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Разрешите Dayside отправлять уведомления в Системных настройках."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita que o Dayside envie notificações nos Ajustes do Sistema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Zezwól aplikacji Dayside na wysyłanie powiadomień w Ustawieniach systemowych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit. Sta meldingen van Dayside toe in Systeeminstellingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono consentite. Consenti le notifiche di Dayside in Impostazioni di Sistema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo chưa bật. Hãy cho phép Dayside gửi thông báo trong Cài đặt hệ thống."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Sistem Ayarları’nda Dayside bildirimlerine izin verin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan nonaktif. Izinkan Dayside mengirim pemberitahuan di Pengaturan Sistem."
          }
        }
      }
    },
