            "value": "도시 데이터가 없어 검색을 사용할 수 없습니다. Dayside를 다시 설치하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Städtedaten fehlen, die Suche ist nicht verfügbar. Installiere Dayside erneut."
          }
        },
        "es": {
          "stringUnit": {
