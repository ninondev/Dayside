      }
    },
    "对方生成名片时的时区数据 %@ 比本机的 %@ 旧，可约时段可能差 1 小时。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名片的时区数据（%1$@）比本机的（%2$@）旧，可约时段可能差1小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名片的時區資料（%@）比本機的（%@）舊，可約時段可能差1小時。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card’s time zone data (%1$@) is older than this Mac’s (%2$@); its availability may be off by an hour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名刺の時間帯データ（%1$@）はこのMacのデータ（%2$@）より古いため、予約可能な時間帯が1時間ずれている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드의 시간대 데이터(%1$@)가 이 Mac의 데이터(%2$@)보다 오래되어 예약 가능 시간이 1시간 어긋날 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitzonendaten der Zeitkarte (%1$@) sind älter als die auf diesem Mac (%2$@); die Verfügbarkeit könnte um eine Stunde abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de zonas horarias de la tarjeta (%1$@) son más antiguos que los de este Mac (%2$@); la disponibilidad podría diferir en una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de fuseaux horaires de la carte (%1$@) sont plus anciennes que celles de ce Mac (%2$@) ; les disponibilités pourraient être décalées d’une heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные часовых поясов в карточке (%1$@) старее данных на этом Mac (%2$@); время для встреч может отличаться на час."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de fusos horários do cartão (%1$@) são mais antigos que os deste Mac (%2$@); os horários disponíveis podem diferir em 1 hora."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizytówkę utworzono z danymi stref czasowych %1$@, starszymi niż %2$@ na tym Macu; godziny dostępności mogą różnić się o godzinę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdzonegegevens van de tijdkaart (%1$@) zijn ouder dan die van deze Mac (%2$@). De beschikbaarheid kan 1 uur afwijken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati dei fusi orari della scheda (%1$@) sono meno recenti di quelli di questo Mac (%2$@); la disponibilità potrebbe differire di un’ora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu múi giờ trên danh thiếp (%1$@) cũ hơn trên máy Mac này (%2$@); giờ có thể hẹn có thể lệch 1 giờ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartın saat dilimi verileri (%1$@) bu Mac’tekinden (%2$@) eski; uygun saatler 1 saat kayabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data zona waktu kartu (%1$@) lebih lama daripada data di Mac ini (%2$@); ketersediaannya mungkin meleset 1 jam."
          }
        }
      },
      "extractionState": "manual"
    },
