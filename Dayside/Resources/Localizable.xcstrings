    "凌晨 1 小时按 2 小时算，深夜 1.5、清晨 1.25": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凌晨1小时按2小时算，深夜1.5、清晨1.25"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hour in the small hours counts as 2 hours; late night 1.5, early morning 1.25"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "凌晨1小時按2小時算，深夜1.5、清晨1.25"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未明の1時間は2時間分、深夜は1.5倍、早朝は1.25倍"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 1시간은 2시간으로, 늦은 밤은 1.5배, 이른 아침은 1.25배로 계산"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 h in den frühen Morgenstunden zählt als 2 h; spät nachts ×1,5, frühmorgens ×1,25"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hora de madrugada cuenta como 2 horas; a última hora de la noche, x1,5; a primera hora de la mañana, x1,25"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 h aux petites heures du matin compte pour 2 h ; tard dans la nuit ×1,5, tôt le matin ×1,25"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В первые часы после полуночи 1 ч считается за 2 ч; поздней ночью — ×1,5, ранним утром — ×1,25"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hora de madrugada conta como 2 horas; fim da noite × 1,5, início da manhã × 1,25"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 godz. po północy liczy się jako 2 godz.; późna noc ×1,5, wczesny poranek ×1,25"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 uur in de kleine uurtjes telt als 2 uur. Diep in de nacht: ×1,5, vroege ochtend: ×1,25."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ora nelle ore piccole vale 2 ore; tarda notte ×1,5, primo mattino ×1,25"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giờ trong khoảng sau nửa đêm được tính là 2 giờ; đêm khuya ×1,5, sáng sớm ×1,25"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece yarısından sonra 1 saat 2 saat sayılır; gece geç saatte 1,5, sabah erken 1,25 saat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 jam dini hari dihitung 2 jam; larut malam ×1,5, pagi-pagi ×1,25"
          }
        }
      }
    },
    "凌晨 1 小时按 3 小时算，深夜 2、清晨 1.5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
