    "时区数据是最新的。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时区数据与已知规则变更一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time zone data matches known rule changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時區資料與已知規則變更一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯データは既知のルール変更と一致しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대 데이터가 알려진 규칙 변경과 일치합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitzonendaten stimmen mit den bekannten Regeländerungen überein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de zonas horarias coinciden con los cambios de reglas conocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de fuseaux horaires correspondent aux changements de règles connus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de fusos horários estão de acordo com as alterações de regra conhecidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные часовых поясов соответствуют известным изменениям правил."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane stref czasowych są zgodne ze znanymi zmianami reguł."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdzonegegevens komen overeen met bekende regelwijzigingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati dei fusi orari corrispondono alle modifiche note alle regole."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu múi giờ khớp với các thay đổi quy tắc đã biết."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dilimi verileri bilinen kural değişiklikleriyle uyumlu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data zona waktu sesuai dengan perubahan aturan yang diketahui."
          }
        }
      }
    },
    "时区数据曾损坏：已备份原始数据，并恢复了可读的部分。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortsdaten waren beschädigt. Der lesbare Teil wurde wiederhergestellt; die Originaldaten wurden gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place data was damaged. Readable places were restored, and the original data was backed up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de lugares estaban dañados. Se ha recuperado la parte legible y se ha guardado una copia de seguridad de los datos originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des lieux étaient endommagées. La partie lisible a été restaurée et les données d’origine ont été sauvegardées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所データが破損していたため、読み取れた場所を復元し、元のデータをバックアップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 데이터가 손상되어 읽을 수 있는 부분을 복원했습니다. 원본 데이터는 백업했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de locais estavam corrompidos. A parte legível foi recuperada e os dados originais foram salvos em backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные мест были повреждены. Доступные для чтения записи восстановлены, а для исходных данных создана резервная копия."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地點資料曾損壞，可讀的部分已還原，原始資料已備份。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点数据曾损坏，已恢复可读的部分，原始数据已备份。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane miejsc były uszkodzone. Czytelne wpisy przywrócono, a oryginalne dane zachowano w kopii zapasowej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatiegegevens waren beschadigd. Leesbare locaties zijn hersteld en er is een reservekopie van het origineel gemaakt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati dei luoghi erano danneggiati. Le voci leggibili sono state ripristinate e i dati originali sono stati salvati in una copia di backup."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu địa điểm bị hỏng. Các mục đọc được đã được khôi phục, bản gốc đã sao lưu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum verileri bozulmuştu. Okunabilen veriler geri yüklendi ve özgün veriler yedeklendi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data lokasi pernah rusak. Bagian yang masih terbaca telah dipulihkan, dan data asli dicadangkan."
          }
        }
      }
    },
    "时区数据未随应用一起安装，搜索不可用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
