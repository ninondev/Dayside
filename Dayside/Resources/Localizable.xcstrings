    "可约时段不会查询日历或预订会议。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可约时段不会查询日历或预订会议。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability doesn’t check your calendar or book meetings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可約時段不會查詢行事曆或預訂會議。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約可能な時間枠を表示する際に、カレンダーを確認したり会議を予約したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 가능 시간은 캘린더를 조회하거나 회의를 예약하는 데 사용되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verfügbarkeit wird ohne Kalenderabfrage ermittelt; es werden keine Besprechungen gebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilidad no consulta calendarios ni reserva reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage des disponibilités ne consulte pas votre calendrier et ne réserve aucune réunion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для определения времени для встреч календарь не проверяется; встречи не бронируются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários disponíveis não consultam seu calendário nem reservam reuniões."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie godzin dostępności nie sprawdza kalendarza ani nie rezerwuje spotkań."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschikbaarheid raadpleegt je agenda niet en boekt geen vergaderingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilità non consulta il calendario e non prenota riunioni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng giờ có thể hẹn không kiểm tra lịch hay đặt cuộc họp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygun saatler belirlenirken takviminiz kontrol edilmez ve toplantı ayarlanmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketersediaan tidak memeriksa kalender atau menjadwalkan pertemuan."
          }
        }
      }
    },
    "各地时间连成一行，能直接贴进聊天。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各地时间连成一行，能直接贴进聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各地時間連成一行，能直接貼進聊天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every place’s time on one line, ready to paste into a chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各地の時刻を1行にまとめます。そのままチャットに貼れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 지역의 시각을 한 줄로 이어 붙여 채팅에 바로 붙여 넣을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ortszeiten in einer Zeile, zum Einfügen in einen Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de cada lugar en una sola línea, lista para pegar en un chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de chaque lieu sur une seule ligne, prête à coller dans une discussion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время всех мест одной строкой, чтобы сразу вставить в чат."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora de cada local em uma só linha, pronta para colar em um chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj godziny ze wszystkich miejsc w jednym wierszu, gotowe do wklejenia na czacie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijden van alle locaties op één regel, klaar om in een chat te plakken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora di ogni luogo su una sola riga, pronta da incollare in una chat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sao chép giờ mọi nơi thành một dòng để dán trực tiếp vào cuộc trò chuyện."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her konumun saati tek satırda, sohbete yapıştırmaya hazır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin waktu setiap lokasi dalam satu baris untuk ditempel ke obrolan."
          }
        }
      }
    },
