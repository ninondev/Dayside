    "光照时段按公开的昼夜节律研究估算（体温最低点取起床前约 3 小时），是参考，不是医疗建议；身体反应因人而异。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光照时段是参考，不是医疗建议；身体反应因人而异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光照時段是參考，不是醫療建議；身體反應因人而異。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light windows are a reference, not medical advice; people respond differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光を浴びる時間は目安であり医療上の助言ではありません。体の反応には個人差があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛 노출 시간대는 참고 자료일 뿐 의학적 조언이 아니며, 몸의 반응은 사람마다 다릅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lichtzeiten dienen zur Orientierung, nicht als medizinischer Rat; Menschen reagieren unterschiedlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las franjas de luz son una referencia, no un consejo médico; cada persona responde de forma distinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les créneaux d’exposition à la lumière sont un repère, pas un conseil médical ; les réactions varient d’une personne à l’autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Периоды воздействия света — справочная информация, а не медицинская рекомендация; реакция организма у всех разная."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os períodos de exposição à luz são uma referência, não uma orientação médica; as reações variam de pessoa para pessoa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pory korzystania ze światła służą orientacji i nie stanowią porady medycznej; reakcja organizmu różni się u poszczególnych osób."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdvakken voor licht zijn een richtlijn, geen medisch advies. Iedereen reageert anders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasce di esposizione alla luce sono indicazioni di riferimento, non consigli medici; la risposta varia da persona a persona."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khung giờ tiếp xúc với ánh sáng chỉ để tham khảo, không phải lời khuyên y tế; phản ứng của cơ thể mỗi người khác nhau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık aralıkları bilgi amaçlıdır ve tıbbi öneri içermez; vücudun tepkisi kişiden kişiye değişir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu paparan cahaya hanya acuan, bukan saran medis; respons tubuh tiap orang berbeda."
          }
        }
      }
    },
