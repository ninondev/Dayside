    "上次计时数据无法读取，已备份原始数据。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次计时数据无法读取，已备份原始数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved timer data couldn’t be read. The original data was backed up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取上次的計時資料，已備份原始資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のタイマーデータを読み取れませんでした。元のデータはバックアップ済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 타이머 데이터를 읽을 수 없습니다. 원본 데이터를 백업했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Timerdaten konnten nicht gelesen werden. Das Original wurde gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer los datos del último temporizador. Se ha guardado una copia de los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les données du dernier minuteur. L’original a été sauvegardé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать данные предыдущего таймера. Создана резервная копия исходных данных."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os dados salvos do timer. Os dados originais foram salvos em backup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać poprzednich danych minutnika. Oryginalne dane zachowano w kopii zapasowej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige timergegevens konden niet worden gelezen. Er is een reservekopie van het origineel gemaakt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i dati dell’ultimo timer. I dati originali sono stati salvati in una copia di backup."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc dữ liệu hẹn giờ lần trước. Dữ liệu gốc đã được sao lưu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki sayaç verileri okunamadı, özgün veriler yedeklendi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data timer sebelumnya tidak dapat dibaca. Data asli telah dicadangkan."
          }
        }
      }
    },
