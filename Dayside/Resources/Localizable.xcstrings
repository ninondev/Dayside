    "先在菜单栏面板添加地点，再查看当地的日照和月相。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板里添加一个城市，就能看到那里的日照和月相。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a city in the panel to see its daylight and moon phase."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板裡新增城市，就能看到那裡的日照和月相。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルで都市を追加すると、その場所の昼の長さと月相を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에서 도시를 추가하면 그곳의 낮의 길이와 달의 위상을 볼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Stadt im Panel hinzu, um ihr Tageslicht und ihre Mondphase zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una ciudad en el panel para ver sus horas de luz y su fase lunar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une ville dans le panneau pour voir la durée du jour et la phase lunaire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте город на панели, чтобы увидеть продолжительность светового дня и фазу Луны."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma cidade no painel para ver a duração da luz solar e a fase da Lua nesse local."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj miasto w panelu, aby zobaczyć długość dnia i fazę Księżyca w tym miejscu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een stad toe in het paneel om daglicht en maanfase te zien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una città nel pannello per vederne le ore di luce e la fase lunare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm một thành phố trong bảng để xem độ dài ban ngày và tuần trăng ở đó."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğu yerdeki gün ışığını ve Ay evresini görmek için panelde bir şehir ekleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kota di panel untuk melihat durasi siang dan fase bulan di sana."
          }
        }
      }
    },
