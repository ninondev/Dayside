    "保存常用的参与者组合，一键切换": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存常用的参与者组合，一键切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存常用的參與者組合，按一下即可切換"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save groups of participants you use often and switch between them with one click"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う参加者のグループを保存して、ワンクリックで切り替えられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 참가자 그룹을 저장하고 한 번의 클릭으로 전환합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufig verwendete Gruppen von Teilnehmenden sichern und mit einem Klick wechseln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda grupos de participantes habituales y cambia entre ellos con un clic"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos groupes habituels de participants et passez de l’un à l’autre en un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить часто используемые группы участников для переключения между ними одним нажатием"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve grupos de participantes usados com frequência e alterne entre eles com um clique"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuj często używane grupy uczestników i przełączaj je jednym kliknięciem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar veelgebruikte groepen deelnemers en wissel met één klik tussen de groepen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i gruppi di partecipanti che usi spesso e passa dall’uno all’altro con un clic"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các nhóm người tham gia thường dùng và chuyển nhóm bằng một lần bấm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullanılan katılımcı gruplarını kaydedin, tek tıkla geçiş yapın"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan grup peserta yang sering dipakai, lalu beralih dengan satu klik"
          }
        }
      }
    },
