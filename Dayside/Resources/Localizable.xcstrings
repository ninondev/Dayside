            "state": "translated",
            "value": "Для всех это нерабочее время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人在工作时段内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人在工作時段內。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie jest wtedy w swoich godzinach pracy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dat moment is niemand binnen de eigen werktijden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quel momento nessuno è nell’orario di lavoro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm này nằm ngoài giờ làm việc của mọi người."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O saatte kimse çalışma saatleri içinde değil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang berada dalam jam kerja saat itu."
