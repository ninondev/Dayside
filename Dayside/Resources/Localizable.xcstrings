    "右键点地图，或在地球窗按 ⌘C": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click the map, or press ⌘C in the Earth window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点地图，或在地球窗口按 ⌘C"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以滑鼠右鍵按一下地圖，或在地球視窗按⌘C"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を右クリック、または地球ウインドウでcommand+Cキーを押す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 오른쪽 클릭하거나 지구 윈도우에서 ⌘C 누르기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните карту правой кнопкой мыши или нажмите ⌘C в окне «Земля»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf die Karte oder ⌘C im Erdfenster"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic secundario en el mapa o pulsa ⌘C en la ventana de la Tierra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur la carte ou appuyez sur ⌘C dans la fenêtre Terre"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito no mapa ou pressione ⌘C na janela Terra"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto destro sulla mappa o premi ⌘C nella finestra Terra"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op de kaart of druk op ⌘C in het aardevenster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij mapę prawym przyciskiem lub naciśnij ⌘C w oknie Ziemi"
